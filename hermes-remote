def cmd_doctor(a):
    if is_win(node(a.name)):
        return doctor_windows(a)
    if node(a.name).get("platform") == "linux":
        return doctor_linux(a)
    r = remote_exec(a.name, DOCTOR)
    sys.stdout.write(r.stdout)
    if r.returncode:
        sys.stderr.write(r.stderr)
        sys.exit(r.returncode)
    print("--- permissions, checked from inside the Hermes Remote Helper app ---")
    r = remote_exec(a.name, 'cat "$HOME/Library/Application Support/HermesRemote/ipc/status.txt" 2>&1; pgrep -fl "Hermes Remote Helper" >/dev/null && echo helper_process=running || echo helper_process=NOT_RUNNING')
    sys.stdout.write(r.stdout)
    if "helper_process=running" in r.stdout:
        rc, o = app_job(a.name, HELPER_PROBE, 60)
        print(o.strip())
    else:
        print("helper not running: re-run the installer on the Mac")


