def cmd_relay_setup(a):
    st = load()
    st["relay"].update(host=a.host or st["relay"]["host"], port=a.port or st["relay"]["port"])
    if a.owner:
        st["relay"]["owner"] = a.owner
    if not st["relay"]["host"]:
        die("--host required on first setup (a DNS name that follows your home IP, e.g. relay.example.com)")
    for d in (HOME, RELAY, SDIR, KEYS):
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(d, 0o700)
    hk = RELAY / "ssh_host_ed25519_key"
    if not hk.exists():
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "hermes-remote-relay", "-f", str(hk)], check=True)
    hermes = KEYS / "hermes_ed25519"
    if not hermes.exists():
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "hermes-remote-operator", "-f", str(hermes)], check=True)
    st["relay"]["user"] = os.environ.get("USER") or Path.home().name
    (RELAY / "sshd_config").write_text(SSHD_CONFIG.format(port=st["relay"]["port"], relay=RELAY, user=st["relay"]["user"]))
    save(st)
    write_relay_files(st)
    chk = run(["/usr/sbin/sshd", "-t", "-f", str(RELAY / "sshd_config")])
    if chk.returncode:
        die("sshd config invalid: " + chk.stderr.strip())
    if not a.no_systemd:
        ud = Path.home() / ".config/systemd/user"
        ud.mkdir(parents=True, exist_ok=True)
        (ud / f"{UNIT_NAME}.service").write_text(UNIT.format(relay=RELAY))
        run(["systemctl", "--user", "daemon-reload"])
        r = run(["systemctl", "--user", "enable", f"{UNIT_NAME}.service"])
        r2 = run(["systemctl", "--user", "restart", f"{UNIT_NAME}.service"])
        if r.returncode or r2.returncode:
            die("systemd start failed: " + (r.stderr + r2.stderr).strip() + f" (journalctl --user -u {UNIT_NAME})")
    print(f"relay config: {RELAY}/sshd_config  (port {st['relay']['port']})")
    print("relay host key:", (RELAY / "ssh_host_ed25519_key.pub").read_text().split()[1][:24] + "...")
    lan = run(["hostname", "-I"]).stdout.split()
    print(f"ROUTER: forward TCP {st['relay']['port']} -> {lan[0] if lan else '<this host LAN IP>'}:{st['relay']['port']}")


def relay_hostkey() -> str:
    f = RELAY / "ssh_host_ed25519_key.pub"
    if not f.exists():
        die("relay not set up: run `hermes-remote relay-setup --host <ddns-name>`")
    return " ".join(f.read_text().split()[:2])


# ------------------------------------------------------------- new / enroll -
TYPES = {"intel": "Intel", "silicon": "AppleSilicon"}
WIN_TYPES = {"win64": "x64", "win32": "x32"}  # Windows 64-bit / 32-bit installers
LINUX_TYPES = {"fedora": "Fedora", "debian": "Debian"}  # Linux distribution families (one installer per family; the CPU is detected)
MAX_PENDING = 10
JOIN_NEW_PER_IP, JOIN_NEW_WINDOW = 3, 3600  # new registrations allowed per source IP per hour


def slug(text: str) -> str:
    t = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:28].strip("-")
    return t if len(t) >= 2 else "mac"


def cmd_new_installer(a):
    """One reusable installer per computer type. Rotating invalidates older copies."""
    st = load()
    if not st["relay"]["host"]:
        die("run relay-setup first")
    hostkey = relay_hostkey()
    hermes_pub = " ".join((KEYS / "hermes_ed25519.pub").read_text().split()[:2]) + " hermes-remote-operator"
    with tempfile.TemporaryDirectory() as td:
        kf = Path(td) / "enroll"
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"enroll-{a.type}", "-f", str(kf)], check=True)
        enroll_priv = kf.read_text()
        enroll_pub = " ".join(kf.with_suffix(".pub").read_text().split()[:2])
    expires = (dt.datetime.now(dt.timezone.utc) + dt.timedelta(days=a.expires_days)).strftime("%Y-%m-%dT%H:%M:%SZ")
    st.setdefault("groups", {})[a.type] = {"enroll_pub": enroll_pub, "expires": expires, "sudo": a.sudo, "created": now()}
    save(st)
    write_relay_files(st)
    if a.type in LINUX_TYPES:
        out = HOME / "installers"
        out.mkdir(mode=0o700, exist_ok=True)
        path = out / f"AgentHub-Remote-{LINUX_TYPES[a.type]}.sh"
        path.write_bytes(build_linux_installer(
            a.type, a.owner or st["relay"].get("owner") or "the support person", st, hostkey, hermes_pub, enroll_priv, expires, "", a.sudo))
        os.chmod(path, 0o700)
        print(f"installer: {path}")
        print(f"reusable for any {LINUX_TYPES[a.type]}-family Linux computer until {expires}; it can only register a PENDING machine, nothing works until you approve its code.")
        return
    if a.type in WIN_TYPES:
        out = HOME / "installers"
        out.mkdir(mode=0o700, exist_ok=True)
        path = out / f"AgentHub-Remote-Windows-{WIN_TYPES[a.type]}.cmd"
        path.write_bytes(build_windows_installer(
            a.type, a.owner or st["relay"].get("owner") or "the support person", st, hostkey, hermes_pub, enroll_priv, expires, ""))
        os.chmod(path, 0o600)
        print(f"installer: {path}")
        print(f"reusable for any Windows {WIN_TYPES[a.type]} PC until {expires}; it can only register a PENDING machine, nothing works until you approve its code.")
        return
    tmpl = (HERE / "installer" / "mac-installer.sh.tmpl").read_text()
    subs = {
        "TYPE": a.type, "OWNER": a.owner or st["relay"].get("owner") or "the support person", "DATE": now(), "EXPIRES": expires,
        "RELAY_HOST": st["relay"]["host"], "RELAY_PORT": str(st["relay"]["port"]),
        "RELAY_USER": st["relay"]["user"], "RELAY_HOSTKEY": hostkey, "HERMES_PUB": hermes_pub,
        "JOIN_MODE": "", "SUDO_MODE": a.sudo, "ENROLL_KEY_B64": base64.b64encode(enroll_priv.encode()).decode(),
        "LAUNCHER_B64": base64.b64encode((HERE / "installer" / "launcher.js").read_bytes()).decode(),
        "HELPER_B64": base64.b64encode((HERE / "installer" / "helper.js").read_bytes()).decode(),
    }
    for k, v in subs.items():
        tmpl = tmpl.replace(f"@@{k}@@", shlex.quote(v))
    out = HOME / "installers"
    out.mkdir(mode=0o700, exist_ok=True)
    path = out / f"Hermes-Remote-{TYPES[a.type]}.command"
    path.write_text(tmpl)
    os.chmod(path, 0o700)
    print(f"installer: {path}")
    print(f"reusable for any {TYPES[a.type]} Mac until {expires}; it can only register a PENDING machine, nothing works until you approve its code.")
    print("each Mac is named from its hostname; nickname later: hermes-remote nickname <node> <nick>")


def ps_quote(text: str) -> str:
    """PowerShell single-quoted string literal."""
    return "'" + text.replace("'", "''") + "'"


WIN_CMD_HEAD = (
    "@echo off\r\nsetlocal\r\ntitle AgentHub Remote Support\r\nset \"HR_SELF=%~f0\"\r\n"
    "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$t=[IO.File]::ReadAllText($env:HR_SELF); $m='#'+'---PS1---'; "
    "$i=$t.IndexOf($m); $f=Join-Path $env:TEMP 'AgentHubRemoteInstall.ps1'; "
    "[IO.File]::WriteAllText($f,$t.Substring($i+$m.Length),(New-Object Text.UTF8Encoding($true))); & $f; Remove-Item -LiteralPath $f -Force -ErrorAction SilentlyContinue\"\r\n"
    "if errorlevel 1 pause\r\nexit /b\r\n#---PS1---\r\n"
)


def fill_windows_template(tmpl: str, subs: dict) -> str:
    """Replace @@NAME@@ placeholders with PowerShell string literals; every placeholder must have a value."""
    def one(m):
        if m.group(1) not in subs:
            raise ValueError("no value for " + m.group(1))
        return ps_quote(subs[m.group(1)])
    out = re.sub(r"@@([A-Z0-9_]+)@@", one, tmpl)
    if "@@" in out:
        raise ValueError("unfilled placeholder")
    return out


def sh_config_block(subs: dict) -> str:
    return "".join(f"{k}={shlex.quote(str(v))}\n" for k, v in subs.items())


def build_linux_installer(ltype: str, owner: str, st: dict, hostkey: str, hermes_pub: str, enroll_priv: str, expires: str, join_mode: str, sudo: str) -> bytes:
    """One shell script: the template with the settings block filled in (no placeholders inside the code)."""
    subs = {
        "TYPE": ltype, "OWNER": owner, "GENERATED": now(), "EXPIRES": expires, "RELAY_HOST": st["relay"]["host"],
        "RELAY_PORT": st["relay"]["port"], "RELAY_USER": st["relay"]["user"], "RELAY_HOSTKEY": hostkey,
        "HERMES_PUB": hermes_pub, "SUDO_MODE": sudo, "JOIN_MODE": join_mode, "ENROLL_KEY_B64": base64.b64encode(enroll_priv.encode()).decode(),
        "HELPER_B64": base64.b64encode((HERE / "installer" / "linux-helper.sh").read_bytes()).decode(),
    }
    tmpl = (HERE / "installer" / "linux-installer.sh.tmpl").read_text()
    if tmpl.count("#@@CONFIG@@\n") != 1:
        raise ValueError("template must contain the settings marker once")
    return tmpl.replace("#@@CONFIG@@\n", sh_config_block(subs)).encode()


def build_windows_installer(wtype: str, owner: str, st: dict, hostkey: str, hermes_pub: str, enroll_priv: str, expires: str, join_mode: str) -> bytes:
    """One self-extracting .cmd: a few batch lines that unpack and run the PowerShell installer."""
    subs = {
        "TYPE": wtype, "OWNER": owner, "DATE": now(), "EXPIRES": expires, "RELAY_HOST": st["relay"]["host"],
        "RELAY_PORT": str(st["relay"]["port"]), "RELAY_USER": st["relay"]["user"], "RELAY_HOSTKEY": hostkey,
        "HERMES_PUB": hermes_pub, "JOIN_MODE": join_mode, "ENROLL_KEY_B64": base64.b64encode(enroll_priv.encode()).decode(),
        "HELPER_B64": base64.b64encode((HERE / "installer" / "win-helper.ps1").read_bytes()).decode(),
    }
    body = fill_windows_template((HERE / "installer" / "win-installer.ps1.tmpl").read_text(), subs)
    if not body.isascii():
        body = body.encode("ascii", "replace").decode()
    return (WIN_CMD_HEAD + body.replace("\r\n", "\n").replace("\n", "\r\n")).encode("ascii")


def join_check(st: dict, ip: str) -> dict:
    """Join mode: registrations are accepted only while the join link is on, and are limited per source IP."""
    import time
    w = join_open(st)
    if not w:
        raise ValueError("this setup link is closed; ask for a new one")
    t = time.time()
    seen = [x for x in st.setdefault("join_seen", []) if x[0] > t - JOIN_NEW_WINDOW]
    st["join_seen"] = seen
    if sum(1 for x in seen if x[1] == ip) >= JOIN_NEW_PER_IP:
        raise ValueError("too many new computers from this address; wait an hour")
    seen.append([t, ip])
    return w


def alloc_id(st: dict) -> int:
    """Lowest free node id (so ids and their ports are reused after pending entries expire)."""
    used = {n["id"] for n in st["nodes"].values()}
    i = 1
    while i in used:
        i += 1
    if i > 3000:
        raise ValueError("too many computers")
    return i


def cmd_enroll_handler(a):
    """Forced command for enrollment keys. JSON on stdin; replies 'OK <ssh> <vnc> <name> <sudo>'."""
    st = load()
    join_mode = a.name == "join"
    g = None if join_mode else st.get("groups", {}).get(a.name)
    try:
        if not join_mode and (not g or not g.get("enroll_pub") or g["expires"] <= now()):
            raise ValueError("installer expired; ask for a new one")
        signal.alarm(10)
        d = json.loads(sys.stdin.read(8192))
        tp, hk, user = d.get("tunnel_pub", ""), d.get("mac_hostkey", ""), d.get("mac_user", "")
        plat = "macos"
        if a.name in WIN_TYPES or (join_mode and str(d.get("platform", "")) == "windows"):
            plat = "windows"
        elif a.name in LINUX_TYPES or (join_mode and str(d.get("platform", "")) == "linux"):
            plat = "linux"
        win = plat == "windows"
        if plat != "macos" and str(d.get("type", a.name)) not in (WIN_TYPES if win else LINUX_TYPES):
            raise ValueError("invalid payload")
        if not (PUB_RE.match(tp) and PUB_RE.match(hk) and (WIN_USER_RE if win else USER_RE).match(user)):
            raise ValueError("invalid payload")
        diag = ""
        if d.get("diag_b64"):
            raw = base64.b64decode(str(d["diag_b64"])[:8000], validate=False).decode("utf-8", "replace")
            diag = "".join(ch for ch in raw if ch == "\n" or ch >= " ")[:3000]
        cutoff = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=7)).strftime("%Y-%m-%dT%H:%M:%SZ")
        for k in [k for k, v in st["nodes"].items() if v["state"] == "pending" and v["enrolled"] < cutoff]:
            del st["nodes"][k]
        same = [k for k, v in st["nodes"].items() if v.get("mac_hostkey") == hk and v["state"] != "revoked"]
        known = bool(same) and st["nodes"][same[0]].get("tunnel_pub") == tp  # this exact machine, re-running
        if same and st["nodes"][same[0]]["state"] == "active":
            old = st["nodes"][same[0]]
            if old["tunnel_pub"] != tp:
                raise ValueError("this Mac is already enrolled with a different key; ask the owner to revoke it first")
            if diag:
                old.update(diag=diag, diag_ts=now())
                save(st)
            print(f"OK {old['ssh_port']} {old['vnc_port']} {same[0]} {old.get('sudo', 'yes')}")  # idempotent re-run / repair
            return
        jrec = None
        if join_mode:
            if not known:
                jrec = join_check(st, (os.environ.get("SSH_CONNECTION", "?").split() or ["?"])[0])
                sudo = jrec["sudo"]
            else:  # known machine re-running: keep what it already has, even after the window closed
                sudo = st["nodes"][same[0]].get("sudo", "yes")
            ntype = str(d["type"]) if plat != "macos" else ("intel" if str(d.get("arch", "")) == "x86_64" else "silicon")
        else:
            sudo, ntype = g["sudo"], a.name
        if same:
            name = same[0]  # re-run of the installer on the same pending Mac
        else:
            if sum(1 for v in st["nodes"].values() if v["state"] == "pending") >= MAX_PENDING:
                raise ValueError("too many unapproved computers waiting; try again later")
            base = slug(str(d.get("hostname", "")))
            name, i = base, 2
            while name in st["nodes"]:
                name, i = f"{base}-{i}", i + 1
            nid = alloc_id(st)
            st["nodes"][name] = {"id": nid, "ssh_port": SSH_PORT_BASE + nid, "vnc_port": VNC_PORT_BASE + nid}
        n = st["nodes"][name]
        n.update(
            state="pending", platform=plat, type=ntype, sudo=sudo, tunnel_pub=tp, mac_hostkey=hk,
            mac_user=user, enrolled=now(), code=code_for(tp, hk),
            info={k: str(d.get(k, ""))[:80] for k in ("hostname", "arch", "os")},
        )
        if jrec and jrec.get("note"):
            n["note"] = jrec["note"]
        if diag:
            n.update(diag=diag, diag_ts=now())
        save(st)
    except Exception as e:  # noqa: BLE001 - report any failure uniformly
        print(f"ERR {e}")
        sys.exit(1)
    with open(SDIR / "events.log", "a") as f:
