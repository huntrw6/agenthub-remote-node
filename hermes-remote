def app_job(name: str, cmd: str, timeout: int = 60) -> tuple[int, str]:
    """Run cmd inside the Mac's Hermes Remote Helper app (it holds the macOS permissions).
    The job is signed with the operator key; the helper verifies against a root-owned allowed_signers."""
    import time
    n = node(name)
    if is_win(n):
        return win_app_job(n, cmd, timeout)
    if n.get("platform") == "linux":
        return lin_app_job(n, cmd, timeout)
    jid = secrets_hex(8)
    job = json.dumps({"id": jid, "ts": int(time.time()), "cmd": cmd})
    with tempfile.TemporaryDirectory() as td:
        jf = Path(td) / "job"
        jf.write_text(job)
        r = run(["ssh-keygen", "-q", "-Y", "sign", "-f", str(KEYS / "hermes_ed25519"), "-n", "hermes-remote-job", str(jf)])
        if r.returncode:
            die("signing failed: " + r.stderr.strip())
        sig = (Path(td) / "job.sig").read_text()
    d = '"$HOME/Library/Application Support/HermesRemote/ipc/jobs"'
    r = subprocess.run(ssh_base(n) + [f"cat > {d}/{jid}.job.tmp && mv {d}/{jid}.job.tmp {d}/{jid}.job"], input=job, text=True, capture_output=True)
    if r.returncode:
        die("could not queue job (is the helper installed?): " + r.stderr.strip()[:200])
    r = subprocess.run(ssh_base(n) + [f"cat > {d}/{jid}.sig"], input=sig, text=True, capture_output=True)
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(1.5)
        r = subprocess.run(ssh_base(n) + [f"cat {d}/{jid}.out 2>/dev/null && rm -f {d}/{jid}.out"], text=True, capture_output=True)
        if r.returncode == 0 and r.stdout.strip():
            o = json.loads(r.stdout)
            return o["rc"], base64.b64decode(o["out"]).decode(errors="replace")
    die("the helper app did not answer (not running, or the Mac is asleep/locked out)")


