#!/usr/bin/env python3
"""hermes-remote: reverse-tunnel remote access to enrolled computers.

Relay  = unprivileged sshd on this host (key-only, forwarding-only keys).
Nodes  = machines running the generated installer; they dial OUT to the relay.
Trust  = single-use enrollment key -> node registers -> short code read aloud
         -> operator approves -> tunnel key becomes active.
State  = $HR_HOME (default ~/.hermes-remote); nothing secret lives in the repo.
"""
from __future__ import annotations

import argparse
import base64
import contextlib
import datetime as dt
import fcntl
import hashlib
import secrets
import json
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOME = Path(os.environ.get("HR_HOME", Path.home() / ".hermes-remote"))
# RELAY is the ONLY directory the sandboxed sshd can see (config, state, authorized_keys).
# Operator secrets (keys/, installers/, shots/) stay outside it in HOME.
RELAY = HOME / "relay"
SDIR = RELAY / "state"  # the only sandbox-writable directory
STATE = SDIR / "nodes.json"
UNIT_NAME = os.environ.get("HR_UNIT", "hermes-remote-relay")
KEYS = HOME / "keys"
HANDLER_PY = "/usr/bin/python3"  # system python: visible inside the sshd sandbox
HANDLER = RELAY / "hermes-remote"  # read-only copy used as the enrollment forced command
SSH_PORT_BASE = int(os.environ.get("HR_SSH_PORT_BASE", 22100))  # tests use another range so they never collide with live tunnels
VNC_PORT_BASE = int(os.environ.get("HR_VNC_PORT_BASE", 25900))
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,30}$")
PUB_RE = re.compile(r"^ssh-ed25519 [A-Za-z0-9+/]{20,}={0,2}$")
USER_RE = re.compile(r"^[A-Za-z0-9._-]{1,32}$")
WIN_USER_RE = re.compile(r"^[A-Za-z0-9._ -]{1,32}$")  # Windows account names may contain spaces
SELF = str(Path(__file__).resolve())


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def die(msg: str, code: int = 1):
    print(f"hermes-remote: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, **kw):
    return subprocess.run(cmd, text=True, capture_output=True, **kw)


# ---------------------------------------------------------------- state ----
@contextlib.contextmanager
def locked():
    SDIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    with open(SDIR / "lock", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def load() -> dict:
    if not STATE.exists():
        return {"relay": {"host": "", "port": 2222, "user": os.environ.get("USER", "agenthub")}, "next_id": 1, "nodes": {}, "groups": {}}
    return json.loads(STATE.read_text())


def save(st: dict) -> None:
    SDIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2, sort_keys=True))
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE)


def pub_blob(pub: str) -> str:
    return pub.split()[1]


def code_for(tunnel_pub: str, mac_hostkey: str) -> str:
    """40-bit code over BOTH the tunnel key and the Mac's SSH host key (8 chars, base16)."""
    msg = f"{tunnel_pub.split()[1]}|{mac_hostkey.split()[1]}"
    h = hashlib.sha256(msg.encode()).hexdigest()[:10].upper()
    return f"{h[:5]}-{h[5:]}"


def join_open(st: dict):
    """The active join settings, or None: the always-on link, else a still-open timed window."""
    if st.get("join_always"):
        return st["join_always"]
    w = st.get("join_window") or {}
    return w if w.get("expires", "") > now() else None


def write_relay_files(st: dict) -> None:
    """Regenerate relay authorized_keys and AgentHub known_hosts from state."""
    RELAY.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp_h = HANDLER.with_suffix(".tmp")
    tmp_h.write_bytes(Path(SELF).read_bytes())
    os.chmod(tmp_h, 0o500)
    os.replace(tmp_h, HANDLER)
    lines = ["# generated by hermes-remote; do not edit"]
    kh = []
    jp = KEYS / "join_ed25519.pub"
    if jp.exists() and join_open(st):
        # public-by-design key: it can only reach the enrollment handler, and only while registration is open
        lines.append(
            f'restrict,command="/usr/bin/env HR_HOME={HOME} HR_SSH_PORT_BASE={SSH_PORT_BASE} HR_VNC_PORT_BASE={VNC_PORT_BASE} {HANDLER_PY} {HANDLER} enroll-handler join" '
            + " ".join(jp.read_text().split()[:2]) + " enroll-join"
        )
    for gname, g in sorted(st.get("groups", {}).items()):
        if g.get("enroll_pub") and g["expires"] > now():
            lines.append(
                f'restrict,command="/usr/bin/env HR_HOME={HOME} HR_SSH_PORT_BASE={SSH_PORT_BASE} HR_VNC_PORT_BASE={VNC_PORT_BASE} {HANDLER_PY} {HANDLER} enroll-handler {gname}" '
                f'{g["enroll_pub"]} enroll-{gname}'
            )
    for name, n in sorted(st["nodes"].items()):
        if n["state"] == "active":
            lines.append(
                f'restrict,port-forwarding,permitlisten="127.0.0.1:{n["ssh_port"]}",'
                f'permitlisten="127.0.0.1:{n["vnc_port"]}",'
                f'command="/bin/false" {n["tunnel_pub"]} tunnel-{name}'
            )
            kh.append(f'[127.0.0.1]:{n["ssh_port"]} {n["mac_hostkey"]}')
    ak = RELAY / "authorized_keys"
    tmp = ak.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, ak)
    (RELAY / "known_hosts").write_text("\n".join(kh) + ("\n" if kh else ""))


