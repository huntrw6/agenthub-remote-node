def repo_ref() -> tuple[str, str]:
    """(commit, raw base URL) of the pushed repo that clients will download from."""
    if os.environ.get("HR_JOIN_REF"):
        return os.environ["HR_JOIN_REF"], os.environ.get("HR_RAW_BASE", "")
    git = lambda *x: subprocess.run(["git", "-C", str(HERE), *x], text=True, capture_output=True)  # noqa: E731
    head = git("rev-parse", "HEAD").stdout.strip()
    url = git("remote", "get-url", "origin").stdout.strip()
    m = re.search(r"github\.com[:/]+([^/]+/[^/.]+?)(?:\.git)?$", url)
    if not head or not m:
        die("this folder must be a git clone of the GitHub repo (origin on github.com)")
    if git("status", "--porcelain", "--", "config", "MANIFEST.sha256", "join.sh", "installer").stdout.strip():
        die("config or installer files have uncommitted changes: run export-config, commit and push first")
    remote = git("ls-remote", "origin", "refs/heads/main").stdout.split()
    if not remote or remote[0] != head:
        die("the pushed main branch differs from this folder: git push first (clients download the pushed commit)")
    return head, f"https://raw.githubusercontent.com/{m.group(1)}/{head}"


