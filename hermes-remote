def published_config_matches(st: dict) -> list:
    """Differences between config/relay.env in this folder and the live relay (empty list = in sync)."""
    f = Path(os.environ.get("HR_CONFIG_DIR", HERE / "config")) / "relay.env"
    if not f.exists():
        return ["config/relay.env is missing: run export-config"]
    got = {}
    for line in f.read_text().splitlines():
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            got[k] = shlex.split(v)[0] if v else ""
    want = {"RELAY_HOST": st["relay"]["host"], "RELAY_PORT": str(st["relay"]["port"]), "RELAY_USER": st["relay"]["user"],
            "RELAY_HOSTKEY": relay_hostkey()}
    if (KEYS / "join_ed25519").exists():
        want["JOIN_KEY_B64"] = base64.b64encode((KEYS / "join_ed25519").read_bytes()).decode()
    return [f"{k} differs" for k, v in want.items() if got.get(k) != v]


