def kill_tunnel(n: dict) -> bool:
    """Close a live tunnel by terminating the sshd session that owns its forwarded port."""
    out = run(["ss", "-H", "-ltnp", f"sport = :{n['ssh_port']}"]).stdout
    pids = {int(m) for m in re.findall(r"pid=(\d+)", out)}
    for pid in pids:
        with contextlib.suppress(OSError):
            os.kill(pid, 15)
    return bool(pids)


