def win_put(n: dict, remote_path: str, data: bytes) -> None:
    """Write bytes to a Windows file over SSH (stdin -> file), atomically via a temp name."""
    script = (f"$p={ps_quote(remote_path)}; $p=$ExecutionContext.InvokeCommand.ExpandString($p); "
              "$t=$p+'.tmp'; $f=[IO.File]::Create($t); [Console]::OpenStandardInput().CopyTo($f); $f.Close(); Move-Item -LiteralPath $t -Destination $p -Force")
    r = subprocess.run(ssh_base(n) + [ps_encoded(script)], input=data, capture_output=True)
    if r.returncode:
        die("could not write file on the PC: " + r.stderr.decode(errors="replace").strip()[:200])


def win_get(n: dict, remote_path: str, delete: bool = False) -> subprocess.CompletedProcess:
    script = (f"$p={ps_quote(remote_path)}; $p=$ExecutionContext.InvokeCommand.ExpandString($p); "
              "if(!(Test-Path -LiteralPath $p)){exit 3}; $b=[IO.File]::ReadAllBytes($p); "
              "$o=[Console]::OpenStandardOutput(); $o.Write($b,0,$b.Length); $o.Flush(); "
              + ("Remove-Item -LiteralPath $p -Force" if delete else ""))
    return subprocess.run(ssh_base(n) + [ps_encoded(script)], capture_output=True)


def win_app_job(n: dict, cmd: str, timeout: int) -> tuple[int, str]:
    """Run a PowerShell snippet inside the helper in the signed-in user's desktop session (signed job)."""
    import time
    jid = secrets_hex(8)
    job = json.dumps({"id": jid, "ts": int(time.time()), "cmd": cmd})
    with tempfile.TemporaryDirectory() as td:
        jf = Path(td) / "job"
        jf.write_text(job)
        r = run(["ssh-keygen", "-q", "-Y", "sign", "-f", str(KEYS / "hermes_ed25519"), "-n", "hermes-remote-job", str(jf)])
        if r.returncode:
            die("signing failed: " + r.stderr.strip())
        sig = (Path(td) / "job.sig").read_text()
    d = WIN_BASE + "/ipc/jobs"
    win_put(n, f"{d}/{jid}.job", job.encode())
    win_put(n, f"{d}/{jid}.sig", sig.encode())
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(1.5)
        r = win_get(n, f"{d}/{jid}.out", delete=True)
        if r.returncode == 0 and r.stdout.strip():
            o = json.loads(r.stdout.decode())
            return o["rc"], base64.b64decode(o["out"]).decode(errors="replace")
    die("the helper did not answer (nobody is signed in on the PC, it is asleep, or the helper is not running)")


def secrets_hex(n: int) -> str:
    return os.urandom(n).hex()


def cmd_gui(a):
    argv = a.argv[1:] if a.argv and a.argv[0] == "--" else a.argv
    rc, out = app_job(a.name, argv[0] if a.sh else (ps_join(argv) if is_win(node(a.name)) else shlex.join(argv)), a.timeout)
    sys.stdout.write(out)
    sys.exit(rc)


def cmd_screenshot(a):
    out = HOME / "shots"
    out.mkdir(mode=0o700, exist_ok=True)
    dest = out / f"{a.name}-{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}.png"
    if is_win(node(a.name)):
        rc, o = app_job(a.name, WIN_SHOT, 60)
    elif node(a.name).get("platform") == "linux":
        rc, o = app_job(a.name, LIN_SHOT, 60)
    else:
        rc, o = app_job(a.name, 't=$(mktemp /tmp/hr.XXXXXX); /usr/sbin/screencapture -x -t png "$t" && /usr/bin/base64 < "$t"; rm -f "$t"', 60)
    try:
        data = base64.b64decode("".join(o.split()), validate=False)
    except Exception:  # noqa: BLE001
        data = b""
    if rc or not data.startswith(b"\x89PNG"):
        die("screenshot failed: " + o.strip()[:300] + (" (is someone signed in and is the screen unlocked? run doctor)" if node(a.name).get("platform") in ("windows", "linux") else " (Screen Recording allowed for the helper? run doctor)"))
    dest.write_bytes(data)
    print(dest)


def cmd_push(a):
    """File transfer over the existing SSH channel (no scp/sftp dependency)."""
    n = node(a.name)
    if is_win(n):
        if a.direction == "push":
            win_put(n, a.remote, Path(a.local).read_bytes())
        else:
            r = win_get(n, a.remote)
            if r.returncode:
                die("transfer failed: " + (r.stderr.decode(errors="replace").strip()[:300] or "file not found"))
            Path(a.local).write_bytes(r.stdout)
        print("ok")
        return
    q = shlex.quote(a.remote)
    if a.direction == "push":
        with open(a.local, "rb") as f:
            r = subprocess.run(ssh_base(n) + [f"cat > {q}"], stdin=f, capture_output=True)
    else:
        dest = Path(a.local)
        r = subprocess.run(ssh_base(n) + [f"cat {q}"], capture_output=True)
        if r.returncode == 0:
            dest.write_bytes(r.stdout)
    if r.returncode:
        die("transfer failed: " + r.stderr.decode(errors="replace").strip()[:300])
    print("ok")


def cmd_vnc(a):
    n = node(a.name)
    if n.get("platform") in ("windows", "linux"):
        die("Only Macs have a VNC tunnel. Use: screenshot <node>, or run/gui commands.")
    print(f"1) tunnel (from a machine that can reach this host): ssh -L 5901:127.0.0.1:{n['vnc_port']} {load()['relay']['user']}@<this-host>")
    print("2) then open vnc://127.0.0.1:5901 and sign in with the Mac account password.")


