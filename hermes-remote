if [ -n "$used" ]; then base64 -w0 "$f"; rc=0; else echo "no working screenshot tool in this session (session=${XDG_SESSION_TYPE:-?} desktop=${XDG_CURRENT_DESKTOP:-?})"; rc=1; fi
rm -rf "$d"; exit $rc
"""

