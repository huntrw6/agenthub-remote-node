def make_zips() -> dict:
    import zipfile
    out = HOME / "installers"
    res = {}
    for t, label in TYPES.items():
        src = out / f"Hermes-Remote-{label}.command"
        if not src.exists():
            continue
        z = out / f"Hermes-Remote-{label}.zip"
        info = zipfile.ZipInfo(src.name, date_time=dt.datetime.now().timetuple()[:6])
        info.external_attr = (0o100755 << 16)  # keep it double-clickable after unzip
        info.compress_type = zipfile.ZIP_DEFLATED
        with zipfile.ZipFile(z, "w") as zf:
            zf.writestr(info, src.read_bytes())
        os.chmod(z, 0o600)
        res[label] = (z, hashlib.sha256(z.read_bytes()).hexdigest())
    for t, label in WIN_TYPES.items():
        src = out / f"AgentHub-Remote-Windows-{label}.cmd"
        if not src.exists():
            continue
        z = out / f"AgentHub-Remote-Windows-{label}.zip"
        with zipfile.ZipFile(z, "w") as zf:
            zf.writestr(zipfile.ZipInfo(src.name, date_time=dt.datetime.now().timetuple()[:6]), src.read_bytes(), zipfile.ZIP_DEFLATED)
        os.chmod(z, 0o600)
        res["Windows " + label] = (z, hashlib.sha256(z.read_bytes()).hexdigest())
    for t, label in LINUX_TYPES.items():
        src = out / f"AgentHub-Remote-{label}.sh"
        if not src.exists():
            continue
        z = out / f"AgentHub-Remote-{label}.zip"
        info = zipfile.ZipInfo(src.name, date_time=dt.datetime.now().timetuple()[:6])
        info.external_attr = (0o100755 << 16)
        info.compress_type = zipfile.ZIP_DEFLATED
        with zipfile.ZipFile(z, "w") as zf:
            zf.writestr(info, src.read_bytes())
        os.chmod(z, 0o600)
        res["Linux " + label] = (z, hashlib.sha256(z.read_bytes()).hexdigest())
    return res


def cmd_serve(a):
    """Temporary LAN download page (random URL, auto-stops)."""
    import http.server
    import secrets
    import threading
    zips = make_zips()
    if not zips:
        die("no installers yet: run new-installer intel|silicon|win64|win32|fedora|debian")
    token = secrets.token_urlsafe(16)
    names = {z.name: z for z, _ in zips.values()}
    rows = "".join(
        f'<li><a href="/{token}/{z.name}" download><b>{label}</b></a> <small>sha256 {h[:16]}…</small></li>'
        for label, (z, h) in zips.items()
    )
    page = (
        "<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width'>"
        "<title>AgentHub Remote installers</title><body style='font:16px system-ui;max-width:42rem;margin:3rem auto;padding:0 1rem'>"
        "<h1>AgentHub Remote installers</h1><p>Pick the one matching the computer "
        "(Mac: menu &gt; About This Mac, <b>Intel</b> or <b>Apple M-chip</b>. Windows: <b>x64</b> for almost every PC; <b>x32</b> only for old 32-bit Windows. Linux: Fedora, RHEL, Rocky, AlmaLinux, Debian, Ubuntu, Mint).</p>"
        f"<ul>{rows}</ul><ol><li>Double-click the downloaded zip to unzip it.</li>"
        "<li>Mac: <b>right-click</b> the .command file and choose <b>Open</b>, then Open again. Windows: double-click the .cmd file; if Windows says it protected your PC, choose <b>More info</b>, then <b>Run anyway</b>. Linux: open a terminal in the folder and run <b>bash AgentHub-Remote-Fedora.sh</b> (Fedora family) or <b>bash AgentHub-Remote-Debian.sh</b> (Debian, Ubuntu, Mint).</li>"
        "<li>Follow the steps; read the final code to the person who sent you here.</li></ol></body>"
    ).encode()
    prefix = f"/{token}/"

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *x):  # no client details in logs beyond status
            sys.stderr.write(f"{now()} {self.client_address[0]} {self.path.split(token)[0] or '/'}... -> {x[1] if len(x) > 1 else ''}\n")

        def do_GET(self):
            if self.path == prefix.rstrip("/") or self.path == prefix:
                body, ctype, extra = page, "text/html; charset=utf-8", {}
            elif self.path.startswith(prefix) and self.path[len(prefix):] in names:
                f = names[self.path[len(prefix):]]
                body, ctype = f.read_bytes(), "application/zip"
                extra = {"Content-Disposition": f'attachment; filename="{f.name}"'}
            else:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            for k, v in extra.items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(body)

    srv = http.server.ThreadingHTTPServer((a.bind, a.port), H)
    threading.Timer(a.minutes * 60, srv.shutdown).start()
    print(f"URL (LAN only, stops in {a.minutes} min): http://{a.bind}:{a.port}{prefix}", flush=True)
    try:
        srv.serve_forever()
    finally:
        srv.server_close()
        print("download page stopped", flush=True)


