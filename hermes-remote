def resolve(st: dict, ref: str) -> str:
    if ref in st["nodes"]:
        return ref
    hits = [k for k, v in st["nodes"].items() if v.get("nickname") == ref and v["state"] != "revoked"]
    if len(hits) == 1:
        return hits[0]
    die(f"unknown node or nickname: {ref}")


