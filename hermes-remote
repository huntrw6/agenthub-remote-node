def ps_encoded(script: str) -> str:
    """A command line that runs a PowerShell script on Windows (any quoting survives; cmd.exe is the SSH shell)."""
    enc = base64.b64encode(("$ProgressPreference='SilentlyContinue';" + script).encode("utf-16-le")).decode()
    return f"powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand {enc}"


def ps_join(argv: list) -> str:
    """argv -> a PowerShell call: & 'prog' 'arg' ..."""
    q = lambda x: "'" + x.replace("'", "''") + "'"  # noqa: E731
    return "& " + " ".join(q(x) for x in argv)


def remote_exec(name: str, script: str, root: bool = False) -> subprocess.CompletedProcess:
    n = node(name)
    if is_win(n):
        # no sudo on Windows: commands run with the rights of the account the node logs in as
        line = ps_encoded(script)
        if len(line) > 7000:  # cmd.exe limits a command line to 8191 characters: upload long scripts as a file and run that
            sp = f"$env:TEMP/hr-{secrets_hex(6)}.ps1"
            win_put(n, sp, b"\xef\xbb\xbf" + script.encode())  # BOM so Windows PowerShell 5.1 reads UTF-8
            run_it = ps_encoded(f"$p=$ExecutionContext.InvokeCommand.ExpandString({ps_quote(sp)}); & powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $p; $c=$LASTEXITCODE; Remove-Item -LiteralPath $p -Force -ErrorAction SilentlyContinue; exit $c")
            return subprocess.run(ssh_base(n) + [run_it], text=True, capture_output=True)
        return subprocess.run(ssh_base(n) + [line], text=True, capture_output=True)
    if root:
        script = f"sudo -n /bin/sh -c {shlex.quote(script)}"
    return subprocess.run(ssh_base(n) + [script], text=True, capture_output=True)


def cmd_run(a):
    argv = a.argv[1:] if a.argv and a.argv[0] == "--" else a.argv
    if argv and argv[0] in ("--sh", "--root"):
        die("put --sh/--root before the node name: run --sh <node> '<script>'")
    if not argv:
        die("no command")
    script = argv[0] if a.sh else (ps_join(argv) if is_win(node(a.name)) else shlex.join(argv))
    r = remote_exec(a.name, script, a.root)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    sys.exit(r.returncode)


