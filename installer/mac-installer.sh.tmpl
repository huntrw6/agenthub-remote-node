#!/bin/bash
# AgentHub Remote installer for @@TYPE@@ Macs (generated by hermes-remote)
# Valid until @@EXPIRES@@. It can only register a computer as PENDING;
# nothing works until the owner approves the code this Mac shows. Safe to read.
set -u
TYPE=@@TYPE@@
OWNER=@@OWNER@@
RELAY_HOST=@@RELAY_HOST@@
RELAY_PORT=@@RELAY_PORT@@
RELAY_USER=@@RELAY_USER@@
RELAY_HOSTKEY=@@RELAY_HOSTKEY@@
HERMES_PUB=@@HERMES_PUB@@
SUDO_MODE=@@SUDO_MODE@@
ENROLL_KEY_B64=@@ENROLL_KEY_B64@@
LAUNCHER_B64=@@LAUNCHER_B64@@
HELPER_B64=@@HELPER_B64@@
GENERATED=@@DATE@@
JOIN_MODE=@@JOIN_MODE@@   # 1 when started by join.sh: the owner chose the sudo setting

# Overridable for tests (HR_TEST=1 skips every macOS/system-changing step).
BASE="${HR_BASE:-/Library/Application Support/HermesRemote}"
HOSTKEY_PUB_FILE="${HR_HOSTKEY_PUB:-/etc/ssh/ssh_host_ed25519_key.pub}"
LOG="${HR_LOG:-$HOME/Library/Logs/HermesRemote-install.log}"
mac_name() { printf '%s' "${HR_FAKE_HOSTNAME:-$(scutil --get ComputerName 2>/dev/null || hostname)}" | tr -cd 'A-Za-z0-9 ._-'; }
NODE="$(mac_name)"
LABEL=studio.illuminary.hermes-remote.tunnel
PLIST=/Library/LaunchDaemons/$LABEL.plist

mkdir -p "$(dirname "$LOG")" 2>/dev/null
b() { printf '\033[1m%s\033[0m\n' "$*"; }
say() { printf '%s\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
fail() { printf '  \033[31m✗ %s\033[0m\n' "$*"; }
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
pause() { printf '\n  Press Return when done... '; read -r _ </dev/tty; }
yesno() { local a; printf '%s [Y/n] ' "$1"; read -r a </dev/tty; case "$a" in n|N|no|NO) return 1;; *) return 0;; esac; }
S() { if [ "${HR_TEST:-0}" = 1 ]; then "$@"; else sudo "$@"; fi; }

# ---------------------------------------------------------------- enrollment
make_tunnel_key() {
  S mkdir -p "$BASE"
  if [ ! -f "$BASE/tunnel_ed25519" ]; then
    local t; t="$(mktemp -d)"
    ssh-keygen -q -t ed25519 -N '' -C "hermes-remote-$NODE" -f "$t/k" >>"$LOG" 2>&1 || return 1
    S cp "$t/k" "$BASE/tunnel_ed25519"; S cp "$t/k.pub" "$BASE/tunnel_ed25519.pub"
    S chown "$(id -un)" "$BASE/tunnel_ed25519" "$BASE/tunnel_ed25519.pub"
    S chmod 600 "$BASE/tunnel_ed25519"; rm -rf "$t"
  fi
  [ -s "$BASE/tunnel_ed25519.pub" ]
}

write_relay_known_hosts() { # $BASE is root-owned: build the file in a temp dir, then install it with sudo
  local t rc; t="$(mktemp -d)" || return 1
  printf '[%s]:%s %s\n' "$RELAY_HOST" "$RELAY_PORT" "$RELAY_HOSTKEY" >"$t/kh"
  S install -m 0644 "$t/kh" "$BASE/relay_known_hosts"; rc=$?
  rm -rf "$t"
  [ $rc -eq 0 ] && [ -s "$BASE/relay_known_hosts" ]
}

# short code both sides derive from the tunnel public key
pair_code() {
  local blob hk h; blob="$(awk '{print $2}' "$BASE/tunnel_ed25519.pub")"
  hk="$(awk '{print $2}' "$HOSTKEY_PUB_FILE")"
  h="$(printf '%s' "$blob|$hk" | shasum -a 256 | cut -c1-10 | tr 'a-f' 'A-F')"
  printf '%s-%s' "$(printf '%s' "$h" | cut -c1-5)" "$(printf '%s' "$h" | cut -c6-10)"
}

enroll() {
  local t pub hk user host arch os resp dg
  [ -r "$HOSTKEY_PUB_FILE" ] || S ssh-keygen -A >>"$LOG" 2>&1
  pub="$(awk '{print $1" "$2}' "$BASE/tunnel_ed25519.pub")"
  hk="$(awk '{print $1" "$2}' "$HOSTKEY_PUB_FILE" 2>/dev/null)"
  [ -n "$hk" ] || { fail "could not read this computer's SSH host key"; return 1; }
  user="$(id -un)"; host="$(mac_name)"
  arch="$(uname -m)"; os="$(sw_vers -productVersion 2>/dev/null || uname -sr)"
  t="$(mktemp -d)"; printf '%s' "$ENROLL_KEY_B64" | base64 --decode >"$t/e"; chmod 600 "$t/e"
  printf '%s %s\n' "$RELAY_HOST" x >/dev/null
  printf '[%s]:%s %s\n' "$RELAY_HOST" "$RELAY_PORT" "$RELAY_HOSTKEY" >"$t/kh"
  dg="$(printf '%s' "${HR_DIAG_TEXT:-}" | base64 | tr -d '\n')"
  resp="$(printf '{"tunnel_pub":"%s","mac_hostkey":"%s","mac_user":"%s","hostname":"%s","arch":"%s","os":"%s","diag_b64":"%s"}' \
      "$pub" "$hk" "$user" "$host" "$arch" "$os" "$dg" |
    ssh -T -i "$t/e" -p "$RELAY_PORT" -F /dev/null -o IdentitiesOnly=yes -o IdentityAgent=none \
      -o BatchMode=yes -o StrictHostKeyChecking=yes -o HostKeyAlgorithms=ssh-ed25519 -o UserKnownHostsFile="$t/kh" \
      -o GlobalKnownHostsFile=/dev/null -o ConnectTimeout=15 "$RELAY_USER@$RELAY_HOST" 2>>"$LOG")"
  rm -rf "$t"
  log "enroll response: $resp"
  case "$resp" in
    "OK "*) set -- $resp; SSH_PORT="$2"; VNC_PORT="$3"; NICK="$4"
      if [ -n "$JOIN_MODE" ]; then case "${5:-}" in yes|ask|no) SUDO_MODE="$5";; esac; fi   # chosen by the owner when opening the window
      case "$SSH_PORT$VNC_PORT" in *[!0-9]*|"") fail "unexpected answer from server"; return 1;; esac
      printf '%s %s %s\n' "$SSH_PORT" "$VNC_PORT" "$NICK" | S tee "$BASE/enrolled" >/dev/null
      ok "registered as '$NICK' with $OWNER's relay"; return 0;;
  esac
  fail "registration was refused (${resp:-no answer}). The installer may have expired; ask for a new one."
  return 1
}

tunnel_plist() {
cat <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$LABEL</string>
<key>UserName</key><string>$(id -un)</string>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>15</integer>
<key>StandardErrorPath</key><string>$BASE/tunnel.log</string>
<key>ProgramArguments</key><array>
<string>/usr/bin/ssh</string><string>-N</string><string>-T</string><string>-F</string><string>/dev/null</string>
<string>-i</string><string>$BASE/tunnel_ed25519</string>
<string>-p</string><string>$RELAY_PORT</string>
<string>-o</string><string>IdentitiesOnly=yes</string><string>-o</string><string>IdentityAgent=none</string>
<string>-o</string><string>BatchMode=yes</string><string>-o</string><string>StrictHostKeyChecking=yes</string>
<string>-o</string><string>HostKeyAlgorithms=ssh-ed25519</string>
<string>-o</string><string>UserKnownHostsFile="$BASE/relay_known_hosts"</string>
<string>-o</string><string>GlobalKnownHostsFile=/dev/null</string>
<string>-o</string><string>ExitOnForwardFailure=yes</string>
<string>-o</string><string>ServerAliveInterval=20</string><string>-o</string><string>ServerAliveCountMax=3</string>
<string>-o</string><string>ConnectTimeout=15</string>
<string>-R</string><string>127.0.0.1:$SSH_PORT:127.0.0.1:22</string>
<string>-R</string><string>127.0.0.1:$VNC_PORT:127.0.0.1:5900</string>
<string>$RELAY_USER@$RELAY_HOST</string>
</array></dict></plist>
PL
}


# ------------------------------------------------- Hermes Remote Helper app
# A tiny background app. macOS permissions are granted to THIS app (it appears by name in every
# Privacy list), and it raises the real macOS pop-ups itself so the installer can advance on its own.
APP="/Applications/Hermes Remote Helper.app"
LAUNCH_AGENT="$HOME/Library/LaunchAgents/studio.illuminary.hermes-remote.helper.plist"
IPC="${HR_IPC:-$HOME/Library/Application Support/HermesRemote/ipc}"
HELPER_LABEL=studio.illuminary.hermes-remote.helper

install_helper() {
  local t want P
  t="$(mktemp -d)"
  printf '%s' "$LAUNCHER_B64" | base64 --decode >"$t/launcher.js"
  printf '%s' "$HELPER_B64" | base64 --decode >"$t/helper.js"
  # logic + trusted signer live in a root-owned folder: other programs running as this user cannot change them
  S install -m 0644 -o root -g wheel "$t/helper.js" "$BASE/helper.js" || return 1
  printf 'hermes namespaces="hermes-remote-job" %s\n' "$(printf '%s' "$HERMES_PUB" | awk '{print $1" "$2}')" >"$t/as"
  S install -m 0644 -o root -g wheel "$t/as" "$BASE/allowed_signers" || return 1
  S chown root:wheel "$BASE"; S chmod 755 "$BASE"
  want="$(printf '%s' "$LAUNCHER_B64" | shasum -a 256 | cut -c1-16)"
  HELPER_REPLACED=0
  if [ ! -d "$APP" ] || [ "$(cat "$BASE/launcher.sha" 2>/dev/null)" != "$want" ]; then
    osacompile -l JavaScript -s -o "$t/Hermes Remote Helper.app" "$t/launcher.js" >>"$LOG" 2>&1 || return 1
    P="$t/Hermes Remote Helper.app/Contents/Info.plist"
    pb() { /usr/libexec/PlistBuddy -c "$1" "$P" >>"$LOG" 2>&1; }
    pb "Set :CFBundleIdentifier $HELPER_LABEL" || pb "Add :CFBundleIdentifier string $HELPER_LABEL"
    pb "Set :CFBundleName Hermes Remote Helper" || pb "Add :CFBundleName string Hermes Remote Helper"
    pb "Add :LSUIElement bool true"
    pb "Add :NSAppleEventsUsageDescription string Lets $OWNER help by operating apps on this Mac when you ask for support."
    pb "Add :NSLocalNetworkUsageDescription string Lets $OWNER check your printer, router and other devices on your home network."
    pb "Add :NSDesktopFolderUsageDescription string Lets $OWNER find and fix files when you ask for support."
    pb "Add :NSDocumentsFolderUsageDescription string Lets $OWNER find and fix files when you ask for support."
    pb "Add :NSDownloadsFolderUsageDescription string Lets $OWNER find and fix files when you ask for support."
    codesign --force --deep --sign - "$t/Hermes Remote Helper.app" >>"$LOG" 2>&1 || return 1
    S rm -rf "$APP"
    S ditto "$t/Hermes Remote Helper.app" "$APP" || return 1
    S chown -R root:wheel "$APP"
    printf '%s' "$want" | S tee "$BASE/launcher.sha" >/dev/null
    S rm -f "$BASE/perms-done"   # a replaced app is a new app to macOS: permissions must be granted again
    HELPER_REPLACED=1
  fi
  rm -rf "$t"
  mkdir -p "$IPC/req" "$IPC/status" "$IPC/jobs"; chmod -R go-rwx "$HOME/Library/Application Support/HermesRemote" 2>/dev/null
  return 0
}

helper_launch_agent() {
  mkdir -p "$HOME/Library/LaunchAgents"
  cat >"$LAUNCH_AGENT" <<LAP
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$HELPER_LABEL</string>
<key>ProgramArguments</key><array><string>/usr/bin/open</string><string>-W</string><string>-g</string><string>-a</string><string>$APP</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>10</integer>
<key>LimitLoadToSessionType</key><string>Aqua</string>
</dict></plist>
LAP
  rm -f "$IPC/status.txt"
  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT" >/dev/null 2>&1
  sleep 1
  launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT" >>"$LOG" 2>&1
  restart_helper
}

restart_helper() {
  pkill -f "Hermes Remote Helper.app/Contents/MacOS" >/dev/null 2>&1
  launchctl kickstart "gui/$(id -u)/$HELPER_LABEL" >/dev/null 2>&1
}
helper_boot() { sed -n 's/^boot=//p' "$IPC/status.txt" 2>/dev/null; }

wait_helper() { # up to 40s for the helper to publish its first status
  local i=0
  while [ $i -lt 40 ]; do [ -s "$IPC/status.txt" ] && return 0; sleep 1; i=$((i+1)); done
  return 1
}

# Ask the helper to trigger one permission, then follow it until macOS reports it granted.
ask_perm() { # kind, title, why, settings-pane
  local kind="$1" title="$2" why="$3" pane="$4" i=0 s k rc opened=0 hinted=0 boot0 boot1
  say; b "  → $title"; say "    $why"
  rm -f "$IPC/status/$kind"; : >"$IPC/req/$kind"; boot0="$(helper_boot)"
  while [ $i -lt 300 ]; do
    s="$(cat "$IPC/status/$kind" 2>/dev/null)"
    case "$s" in
      granted) ok "$title allowed"; return 0;;
      settings)
        if [ $opened = 0 ]; then
          say "    System Settings is opening. Switch ON  \"Hermes Remote Helper\"  in the list."
          say "    (Not listed? Click +, choose Applications > Hermes Remote Helper.)"
          say "    If macOS offers \"Quit & Reopen\", choose it. This screen moves on by itself;"
          say "    if it doesn't within 15 seconds, press Return."
          open "x-apple.systempreferences:com.apple.preference.security?$pane"; opened=1
        fi;;
      pending)
        if [ $hinted = 0 ]; then say "    A macOS pop-up is asking for permission: click Allow."; hinted=1; fi
        if [ $i -ge 30 ] && [ $opened = 0 ]; then
          say "    No pop-up, or you chose Don't Allow? Opening the setting: switch ON \"Hermes Remote Helper\"."
          open "x-apple.systempreferences:com.apple.preference.security?$pane"; opened=1
        fi;;
    esac
    # the helper restarted (macOS "Quit & Reopen" or Return): its in-memory request is gone, so ask again
    boot1="$(helper_boot)"
    if [ -n "$boot1" ] && [ "$boot1" != "$boot0" ]; then boot0="$boot1"; rm -f "$IPC/status/$kind"; : >"$IPC/req/$kind"; fi
    k=""; rc=0
    { read -r -s -n 1 -t 1 k </dev/tty; rc=$?; } 2>/dev/null
    if [ $rc -eq 0 ]; then
      case "$k" in s|S) warn "skipped $title"; return 0;; *) [ $opened = 1 ] && restart_helper;; esac
    elif [ $rc -le 128 ]; then sleep 1   # no terminal attached: still pace the loop
    fi
    i=$((i+1))
  done
  warn "$title wasn't confirmed after 5 minutes. Continuing; run this file again to finish it."
  return 0
}

tunnel_selftest() {
  ssh -F /dev/null -i "$BASE/tunnel_ed25519" -p "$RELAY_PORT" -o IdentitiesOnly=yes -o IdentityAgent=none \
    -o BatchMode=yes -o StrictHostKeyChecking=yes -o HostKeyAlgorithms=ssh-ed25519 \
    -o "UserKnownHostsFile=\"$BASE/relay_known_hosts\"" -o GlobalKnownHostsFile=/dev/null -o ConnectTimeout=10 \
    "$RELAY_USER@$RELAY_HOST" true 2>&1 | head -3 | tr '\n' ' '
}

# Non-secret health report so the owner can see what happened on this Mac without asking you to copy anything.
send_diag() {
  local d
  d="$(printf 'time=%s\nmacos=%s arch=%s\nselftest=%s\nservice:\n%s\ntunnel.log:\n%s\nsshd_listening=%s\nfilevault=%s\n' \
    "$(date '+%F %T')" "$(sw_vers -productVersion 2>/dev/null)" "$(uname -m)" "${SELFTEST:-n/a}" \
    "$(sudo launchctl print "system/$LABEL" 2>&1 | grep -E 'state|last exit|runs|pid' | head -6)" \
    "$(tail -8 "$BASE/tunnel.log" 2>/dev/null)" \
    "$(nc -z 127.0.0.1 22 >/dev/null 2>&1 && echo yes || echo no)" "$(fdesetup status 2>/dev/null | head -1)")"
  HR_DIAG_TEXT="$d" enroll >/dev/null 2>&1
}

[ "${HR_SOURCE_ONLY:-0}" = 1 ] && return 0 2>/dev/null

# ---------------------------------------------------------------------- main
clear
b "AgentHub Remote Support — setup for \"$NODE\""
say
say "This lets $OWNER securely connect to this Mac to fix and test things for you."
say "It will:"
say "  1. keep a private, encrypted connection open to $OWNER's server"
say "  2. turn on Remote Login and Screen Sharing"
say "  3. ask you to approve several macOS permissions (a few clicks each)"
say "Nothing is downloaded from the internet. This takes about 5 minutes."
say
b "What you are agreeing to"
say "  • $OWNER will be able to use this Mac as if he were sitting at it: open and change"
say "    files, run programs, see the screen, and make administrator-level changes."
say "  • It stays on, even after restarts, until it is removed."
say "  • To remove it later: open Terminal and run  sudo \"$BASE/uninstall.sh\""
say
if ! yesno "Do you want to continue?"; then say "Cancelled. Nothing was changed."; exit 0; fi
[ "$(uname -s)" = Darwin ] || { fail "This installer is for macOS only."; exit 1; }
case "$(uname -m)" in
  arm64) say "Detected: Apple silicon Mac"; [ "$TYPE" = silicon ] || warn "This installer is for Intel Macs; ask $OWNER for the Apple silicon one.";;
  x86_64) say "Detected: Intel Mac"; [ "$TYPE" = intel ] || warn "This installer is for Apple silicon Macs; ask $OWNER for the Intel one.";;
esac
ver="$(sw_vers -productVersion)"; say "macOS $ver"
major="${ver%%.*}"; [ "${major:-0}" -ge 11 ] || warn "macOS older than 11: untested, continuing anyway."
pause

b "Step 1/7 — Administrator password"
say "Terminal will ask for this Mac's login password (you won't see it as you type)."
sudo -v || { fail "Administrator access is needed."; exit 1; }
( while true; do sudo -n true 2>/dev/null; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) &
KEEP=$!; trap 'kill $KEEP 2>/dev/null' EXIT
ok "administrator access granted"

b "Step 2/7 — Checking the internet connection to $OWNER's server"
if nc -z -G 8 "$RELAY_HOST" "$RELAY_PORT" >/dev/null 2>&1; then ok "server reachable"; else
  fail "cannot reach $RELAY_HOST:$RELAY_PORT. Check this Mac's Wi-Fi, then run this file again."; exit 1; fi

b "Step 3/7 — Remote Login (secure shell)"
sudo systemsetup -setremotelogin on >>"$LOG" 2>&1
if ! nc -z 127.0.0.1 22 >/dev/null 2>&1; then
  sudo launchctl enable system/com.openssh.sshd >>"$LOG" 2>&1
  sudo launchctl bootstrap system /System/Library/LaunchDaemons/ssh.plist >>"$LOG" 2>&1
fi
if ! nc -z 127.0.0.1 22 >/dev/null 2>&1; then
  warn "macOS wants Terminal to have Full Disk Access before Remote Login can be turned on."
  say "  Opening the setting. Turn ON 'Terminal', then come back."
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"; pause
  sudo systemsetup -setremotelogin on >>"$LOG" 2>&1
fi
nc -z 127.0.0.1 22 >/dev/null 2>&1 && ok "Remote Login is on" || { fail "Remote Login could not be turned on (see $LOG)"; exit 1; }
# key-only logins: no passwords accepted over SSH
sudo mkdir -p /etc/ssh/sshd_config.d
if grep -qs '^Include' /etc/ssh/sshd_config; then
  printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' | sudo tee /etc/ssh/sshd_config.d/100-hermes-remote.conf >/dev/null
  if ! sudo /usr/sbin/sshd -t >>"$LOG" 2>&1; then sudo rm -f /etc/ssh/sshd_config.d/100-hermes-remote.conf; warn "skipped SSH hardening"; else ok "password logins over SSH disabled (keys only)"; fi
fi
mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"; touch "$HOME/.ssh/authorized_keys"; chmod 600 "$HOME/.ssh/authorized_keys"
grep -qF "$(printf '%s' "$HERMES_PUB" | awk '{print $2}')" "$HOME/.ssh/authorized_keys" || printf '%s\n' "$HERMES_PUB" >>"$HOME/.ssh/authorized_keys"
ok "AgentHub's key authorized for $(id -un)"

b "Step 4/7 — Registering this Mac"
make_tunnel_key && write_relay_known_hosts || { fail "could not create the connection key"; exit 1; }
enroll || exit 1
read -r SSH_PORT VNC_PORT _ <"$BASE/enrolled"
CODE="$(pair_code)"

b "Step 5/7 — Administrator commands, Screen Sharing, power"
case "$SUDO_MODE" in
  yes) DO_SUDO=1;;
  ask) yesno "  Let $OWNER run administrator commands without asking you each time?" && DO_SUDO=1 || DO_SUDO=0;;
  *) DO_SUDO=0;;
esac
if [ "$DO_SUDO" = 1 ]; then
  tmp="$(mktemp)"; printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$(id -un)" >"$tmp"
  if sudo /usr/sbin/visudo -cf "$tmp" >>"$LOG" 2>&1; then
    sudo install -m 0440 -o root -g wheel "$tmp" /etc/sudoers.d/hermes-remote && ok "administrator commands allowed for remote support"
  else fail "sudoers check failed; skipped"; fi
  rm -f "$tmp"
fi
sudo launchctl enable system/com.apple.screensharing >>"$LOG" 2>&1
sudo launchctl bootstrap system /System/Library/LaunchDaemons/com.apple.screensharing.plist >>"$LOG" 2>&1
if ! nc -z 127.0.0.1 5900 >/dev/null 2>&1; then
  sudo /System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart \
    -activate -configure -access -on -users "$(id -un)" -privs -all -restart -agent >>"$LOG" 2>&1
fi
nc -z 127.0.0.1 5900 >/dev/null 2>&1 && ok "Screen Sharing is on" || warn "Screen Sharing could not be confirmed (turn on in System Settings > General > Sharing)"
# FileVault: after a restart or power cut the Mac waits at the disk-unlock screen, so nothing can start.
if fdesetup status 2>/dev/null | grep -q "FileVault is On"; then
  warn "FileVault (disk encryption) is ON. If this Mac restarts or loses power, remote access"
  say "    stays off until someone types the password at the login screen. It protects your files"
  say "    if the Mac is lost or stolen, so it is being left on. Tell $OWNER if this matters."
  FV=on
else FV=off; fi
sudo pmset -c sleep 0 womp 1 >>"$LOG" 2>&1; sudo pmset -a autorestart 1 >>"$LOG" 2>&1
ok "stays reachable while plugged in; restarts itself after a power cut"
if pmset -g batt 2>/dev/null | grep -qi "InternalBattery"; then
  warn "This is a laptop: it can still sleep on battery or with the lid closed, which pauses remote access."
  say "    Keep it plugged in and the lid open when you want $OWNER to help."
fi

b "Step 6/7 — Starting the secure connection"
sudo touch "$BASE/tunnel.log"; sudo chown "$(id -un)" "$BASE/tunnel.log"
tunnel_plist | sudo tee "$PLIST" >/dev/null
sudo chown root:wheel "$PLIST"; sudo chmod 644 "$PLIST"
sudo launchctl bootout system "$PLIST" >/dev/null 2>&1; sleep 2
n=0
until sudo launchctl bootstrap system "$PLIST" >>"$LOG" 2>&1 || [ $n -ge 5 ]; do
  n=$((n+1)); sleep 2; sudo launchctl bootout system "$PLIST" >/dev/null 2>&1; sleep 1
done
sudo launchctl kickstart -k "system/$LABEL" >>"$LOG" 2>&1; sleep 4
if sudo launchctl print "system/$LABEL" 2>/dev/null | grep -q "state = running"; then ok "connection service is running (starts at boot)"; else warn "connection service is not running yet (see $LOG)"; fi
SELFTEST="$(tunnel_selftest)"
case "$SELFTEST" in
  *"Host key verification failed"*) fail "this Mac does not trust the server's identity; $OWNER will be told automatically.";;
  *"Permission denied"*) ok "server reachable and trusted (waiting for $OWNER to approve this Mac)";;
  *"timed out"*|*"refused"*|*"resolve"*|*"No route"*) warn "cannot reach the server right now: $SELFTEST";;
  *) ok "secure connection works";;
esac
send_diag
# uninstaller (Terminal only)
sudo tee "$BASE/uninstall.sh" >/dev/null <<UN
#!/bin/bash
# Removes AgentHub Remote Support. Run: sudo "$BASE/uninstall.sh"
launchctl bootout system $PLIST 2>/dev/null; rm -f $PLIST /etc/sudoers.d/hermes-remote /etc/ssh/sshd_config.d/100-hermes-remote.conf
sed -i '' '/hermes-remote-operator/d' "$HOME/.ssh/authorized_keys" 2>/dev/null
launchctl bootout gui/$(id -u) "$LAUNCH_AGENT" 2>/dev/null; pkill -f "Hermes Remote Helper" 2>/dev/null
rm -f "$LAUNCH_AGENT"; rm -rf "$APP" "$HOME/Library/Application Support/HermesRemote"
rm -rf "$BASE"; echo "AgentHub Remote Support removed (Remote Login / Screen Sharing left as they were)."
UN
sudo chmod 755 "$BASE/uninstall.sh"

b "Step 7/7 — macOS permissions"
say "A small helper app called \"Hermes Remote Helper\" is being installed. macOS permissions are given"
say "to it by name, and it asks macOS for each one in turn. When a pop-up appears, click Allow."
say "(Press s at any prompt to skip it.)"
if ! install_helper; then fail "could not install the helper app (see $LOG)"; exit 1; fi
helper_launch_agent
if ! wait_helper; then fail "the helper app did not start (see $LOG and ~/Library/Logs/HermesRemote-helper.log)"; exit 1; fi
ok "helper app is running (it also starts every time you log in)"
if [ -f "$BASE/perms-done" ] && yesno "  Permissions were already set up on an earlier run. Skip them?"; then :; else
ask_perm lan "Local Network" "Lets support check your printer, router and other devices at home." Privacy_LocalNetwork
ask_perm automation "Control other apps (System Events and Finder)" "Lets support operate apps and System Settings for you. You will see two pop-ups (System Events, then Finder): click Allow on both." Privacy_Automation
ask_perm files "Desktop, Documents and Downloads" "Lets support find and repair your files." Privacy_FilesAndFolders
ask_perm screen "Screen & System Audio Recording" "Lets support see your screen to help." Privacy_ScreenCapture
ask_perm capture "Screen capture approval" "Lets support take screenshots. macOS may ask to 'bypass the system private window picker': choose Allow (or Allow For One Month). It asks again about monthly; click Allow then too." Privacy_ScreenCapture
ask_perm accessibility "Accessibility" "Lets support click and type when fixing things." Privacy_Accessibility
ask_perm input "Input Monitoring" "Lets support test keyboard and mouse behavior." Privacy_ListenEvent
ask_perm fda "Full Disk Access" "Lets support read and repair any file on this Mac." Privacy_AllFiles
S touch "$BASE/perms-done"
fi
say; say "Other permissions (Photos, Contacts, Calendar...) pop up the first time they are needed; click Allow."

echo
b "ALL DONE ✔"
printf '%s' "$CODE" | pbcopy 2>/dev/null
say
say "Please read this code to $OWNER so he can finish connecting this Mac:"
printf '\n        \033[1;7m  %s  \033[0m\n\n' "$CODE"
say "(Keep this window open until you've told him. You can then close it.)"
pause
