#!/bin/bash
# AgentHub Remote installer for Linux (Fedora family: Fedora, RHEL, Rocky, AlmaLinux, CentOS Stream;
# Debian family: Debian, Ubuntu, Linux Mint, Pop!_OS, Raspberry Pi OS and other Debian/Ubuntu based systems).
# Generated by hermes-remote. It can only register this computer as PENDING:
# nothing works until the owner approves the code this computer shows. Safe to read.
#
# What it does (it asks before it changes anything):
#   1. installs OpenSSH (only if missing; the normal SSH server on port 22 stays OFF) and a tool for screenshots
#   2. makes keys, registers this computer with the owner's relay, and shows an approval code
#   3. adds a PRIVATE SSH server (a unix socket, no network port) and a tunnel service that holds
#      an outbound connection to the owner's relay. Nothing listens on the network.
#   4. adds a helper that runs in your desktop session (for screenshots and desktop tasks)
# Remove everything later with:  sudo /etc/agenthub-remote/uninstall.sh
set -u
#@@CONFIG@@
# the block above sets: OWNER RELAY_HOST RELAY_PORT RELAY_USER RELAY_HOSTKEY HERMES_PUB SUDO_MODE
#                       ENROLL_KEY_B64 HELPER_B64 GENERATED EXPIRES JOIN_MODE TYPE

# Overridable for tests (HR_TEST=1 skips every step that changes the system).
BASE="${HR_BASE:-/etc/agenthub-remote}"
RUNDIR="${HR_RUNDIR:-/run/agenthub-remote}"
UNITDIR="${HR_UNITDIR:-/etc/systemd/system}"
SUDOERS_FILE="${HR_SUDOERS:-/etc/sudoers.d/agenthub-remote}"
LOGIND_FILE="${HR_LOGIND:-/etc/systemd/logind.conf.d/agenthub-remote.conf}"
SVC_USER=agenthub-remote
DESK_USER="${HR_USER:-$(id -un)}"
DESK_HOME="${HR_HOME_DIR:-$HOME}"
LOG="${HR_LOG:-$DESK_HOME/agenthub-remote-install.log}"
IPC="$DESK_HOME/.local/share/agenthub-remote/ipc"
HELPER="$DESK_HOME/.local/share/agenthub-remote/helper.sh"
AUTOSTART="$DESK_HOME/.config/autostart/agenthub-remote-helper.desktop"
HOSTKEY="$BASE/ssh_host_ed25519_key"
SOCK="$RUNDIR/sshd.sock"

node_name() { printf '%s' "${HR_FAKE_HOSTNAME:-$(hostname -s 2>/dev/null || hostname)}" | tr -cd 'A-Za-z0-9 ._-'; }
NODE="$(node_name)"; [ -n "$NODE" ] || NODE=linux-pc

b() { printf '\033[1m%s\033[0m\n' "$*"; }
say() { printf '%s\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
fail() { printf '  \033[31m✗ %s\033[0m\n' "$*"; }
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null; }
pause() { [ "${HR_TEST:-0}" = 1 ] && return 0; printf '\n  Press Return to continue... '; read -r _ </dev/tty; }
yesno() { local a; [ "${HR_TEST:-0}" = 1 ] && return 0; printf '%s [Y/n] ' "$1"; read -r a </dev/tty; case "$a" in n|N|no|NO) return 1;; *) return 0;; esac; }
# S runs a command with administrator rights. Tests set HR_SUDO= (empty) to run it directly.
S() { if [ -n "${HR_SUDO+x}" ]; then if [ -n "$HR_SUDO" ]; then "$HR_SUDO" "$@"; else "$@"; fi; else sudo "$@"; fi; }
# owner changes are skipped in tests, where the user is not root
own() { [ "${HR_TEST:-0}" = 1 ] && return 0; S chown "$@"; }
sysctl_() { [ "${HR_TEST:-0}" = 1 ] || [ -n "${HR_NO_SYSTEMD:-}" ] && return 0; S systemctl "$@"; }

# ------------------------------------------------------------- files we generate (each is checked by tests)
render_sshd_config() {
cat <<EOF
# AgentHub Remote: private SSH server. It is started by a systemd socket (a unix socket, no network port).
HostKey $HOSTKEY
AuthorizedKeysFile $BASE/authorized_keys
AllowUsers $DESK_USER
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM ${HR_USEPAM:-yes}
AllowTcpForwarding no
GatewayPorts no
X11Forwarding no
MaxAuthTries 3
LoginGraceTime 20
ClientAliveInterval 30
ClientAliveCountMax 4
PrintMotd no
Subsystem sftp internal-sftp
EOF
}

render_socket_unit() {
cat <<EOF
[Unit]
Description=AgentHub Remote private SSH socket

[Socket]
ListenStream=$SOCK
Accept=yes
SocketMode=0660
SocketUser=root
SocketGroup=$SVC_USER
DirectoryMode=0755

[Install]
WantedBy=sockets.target
EOF
}

render_sshd_service() {
cat <<EOF
[Unit]
Description=AgentHub Remote private SSH server (one per connection)

[Service]
ExecStart=-/usr/sbin/sshd -i -f $BASE/sshd_config
StandardInput=socket
# Debian and Ubuntu refuse to run sshd as root without /run/sshd (privilege separation directory)
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
EOF
}

render_tunnel_unit() { # $1 = port on the owner's relay
cat <<EOF
[Unit]
Description=AgentHub Remote tunnel (outbound connection to $RELAY_HOST)
Wants=network-online.target
After=network-online.target

[Service]
User=$SVC_USER
ExecStart=/usr/bin/ssh -N -T -F /dev/null -i $BASE/tunnel_ed25519 -p $RELAY_PORT \\
  -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes -o StrictHostKeyChecking=yes \\
  -o HostKeyAlgorithms=ssh-ed25519 -o "UserKnownHostsFile=$BASE/relay_known_hosts" -o GlobalKnownHostsFile=/dev/null \\
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=15 \\
  -R 127.0.0.1:$1:$SOCK $RELAY_USER@$RELAY_HOST
Restart=always
RestartSec=15
StandardError=append:$BASE/tunnel.log
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
EOF
}

render_sudoers() {
printf '# AgentHub Remote: administrator commands for remote support (remove with the uninstaller)\n%s ALL=(ALL) NOPASSWD:ALL\n' "$DESK_USER"
}

render_logind() {
printf '# AgentHub Remote: stay reachable when plugged in\n[Login]\nHandleLidSwitchExternalPower=ignore\nIdleAction=ignore\n'
}

render_autostart() {
cat <<EOF
[Desktop Entry]
Type=Application
Name=AgentHub Remote Helper
Comment=Lets remote support take screenshots and run desktop tasks that you allowed
Exec=/bin/bash $HELPER
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
}

render_uninstall() {
cat <<EOF
#!/bin/bash
# Removes AgentHub Remote Support. Run:  sudo $BASE/uninstall.sh
[ "\$(id -u)" = 0 ] || { echo "run with sudo"; exit 1; }
systemctl disable --now agenthub-remote-tunnel.service agenthub-remote-sshd.socket 2>/dev/null
systemctl stop 'agenthub-remote-sshd@*.service' 2>/dev/null
rm -f $UNITDIR/agenthub-remote-tunnel.service $UNITDIR/agenthub-remote-sshd.socket $UNITDIR/agenthub-remote-sshd@.service
systemctl daemon-reload 2>/dev/null
rm -f $SUDOERS_FILE $LOGIND_FILE
systemctl restart systemd-logind 2>/dev/null
pkill -u $DESK_USER -f 'agenthub-remote/helper.sh' 2>/dev/null
rm -f $AUTOSTART
rm -rf $DESK_HOME/.local/share/agenthub-remote
userdel $SVC_USER 2>/dev/null
rm -rf $BASE $RUNDIR
echo "AgentHub Remote Support removed. OpenSSH and the screenshot tool were left installed."
EOF
}

# ------------------------------------------------------------- enrollment
pair_code() {
  local blob hk h
  blob="$(awk '{print $2}' "$BASE/tunnel_ed25519.pub")"
  hk="$(awk '{print $2}' "$HOSTKEY.pub")"
  h="$(printf '%s' "$blob|$hk" | sha256sum | cut -c1-10 | tr 'a-f' 'A-F')"
  printf '%s-%s' "$(printf '%s' "$h" | cut -c1-5)" "$(printf '%s' "$h" | cut -c6-10)"
}

enroll() {
  local t pub hk resp dg os
  pub="$(awk '{print $1" "$2}' "$BASE/tunnel_ed25519.pub")"
  hk="$(awk '{print $1" "$2}' "$HOSTKEY.pub" 2>/dev/null)"
  [ -n "$hk" ] || { fail "could not read this computer's SSH host key"; return 1; }
  os="$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-Linux}")"
  t="$(mktemp -d)"; printf '%s' "$ENROLL_KEY_B64" | base64 --decode >"$t/e"; chmod 600 "$t/e"
  printf '[%s]:%s %s\n' "$RELAY_HOST" "$RELAY_PORT" "$RELAY_HOSTKEY" >"$t/kh"
  dg="$(printf '%s' "${HR_DIAG_TEXT:-}" | base64 -w0)"
  resp="$(printf '{"tunnel_pub":"%s","mac_hostkey":"%s","mac_user":"%s","hostname":"%s","arch":"%s","os":"%s","platform":"linux","type":"%s","diag_b64":"%s"}' \
      "$pub" "$hk" "$DESK_USER" "$NODE" "$(uname -m)" "$os" "$TYPE" "$dg" |
    ssh -T -i "$t/e" -p "$RELAY_PORT" -F /dev/null -o IdentitiesOnly=yes -o IdentityAgent=none \
      -o BatchMode=yes -o StrictHostKeyChecking=yes -o HostKeyAlgorithms=ssh-ed25519 -o UserKnownHostsFile="$t/kh" \
      -o GlobalKnownHostsFile=/dev/null -o ConnectTimeout=15 "$RELAY_USER@$RELAY_HOST" 2>>"$LOG")"
  rm -rf "$t"
  log "enroll response: $resp"
  case "$resp" in
    "OK "*) set -- $resp; SSH_PORT="$2"; NICK="$4"
      if [ -n "$JOIN_MODE" ]; then case "${5:-}" in yes|ask|no) SUDO_MODE="$5";; esac; fi
      case "$SSH_PORT" in *[!0-9]*|"") fail "unexpected answer from server"; return 1;; esac
      printf '%s %s %s\n' "$SSH_PORT" "$2" "$NICK" | S tee "$BASE/enrolled" >/dev/null
      ok "registered as '$NICK' with $OWNER's relay"; return 0;;
  esac
  fail "registration was refused (${resp:-no answer}). The installer may have expired; ask for a new one."
  return 1
}

tunnel_selftest() {
  ssh -F /dev/null -i "$BASE/tunnel_ed25519" -p "$RELAY_PORT" -o IdentitiesOnly=yes -o IdentityAgent=none \
    -o BatchMode=yes -o StrictHostKeyChecking=yes -o HostKeyAlgorithms=ssh-ed25519 \
    -o "UserKnownHostsFile=$BASE/relay_known_hosts" -o GlobalKnownHostsFile=/dev/null -o ConnectTimeout=10 \
    "$RELAY_USER@$RELAY_HOST" true 2>&1 | head -3 | tr '\n' ' '
}

# ------------------------------------------------------------- distribution family
have_cmd() { # (HR_MISSING lets tests pretend a program is not installed)
  case " ${HR_MISSING:-} " in *" $1 "*) return 1;; esac
  command -v "$1" >/dev/null 2>&1
}
have_sshd() { case " ${HR_MISSING:-} " in *" sshd "*) return 1;; esac; [ -x /usr/sbin/sshd ]; }

# family of THIS computer, from /etc/os-release: fedora | debian | (empty = unsupported)
detect_family() {
  local osr="${HR_OS_RELEASE:-/etc/os-release}" ID="" ID_LIKE=""
  [ -r "$osr" ] && . "$osr"
  case " ${ID:-} ${ID_LIKE:-} " in
    *" fedora "*|*" rhel "*|*" centos "*) echo fedora; return;;
    *" debian "*|*" ubuntu "*) echo debian; return;;
  esac
}

# package names differ between the families
pkg_ssh_client() { [ "$TYPE" = debian ] && echo openssh-client || echo openssh-clients; }
pkg_for_tool() { # screenshot tool -> package
  case "$1:$TYPE" in
    spectacle:debian) echo kde-spectacle;;
    import:debian|import:fedora) echo ImageMagick;;
    *) echo "$1";;
  esac
}

# Installs packages. On Debian/Ubuntu the package system starts and enables a NORMAL SSH server on port 22 when
# openssh-server is installed; that must not happen here, so starting services is blocked during the install.
install_packages() {
  [ $# -gt 0 ] || return 0
  if [ "$TYPE" = debian ]; then
    local pol=/usr/sbin/policy-rc.d made=0 rc
    if [ ! -e "${HR_POLICY:-$pol}" ]; then
      printf '#!/bin/sh\nexit 101\n' | S tee "${HR_POLICY:-$pol}" >/dev/null && S chmod 755 "${HR_POLICY:-$pol}" && made=1
    fi
    S env DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=180 update >>"$LOG" 2>&1
    S env DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=180 -y --no-install-recommends install "$@" >>"$LOG" 2>&1; rc=$?
    [ "$made" = 1 ] && S rm -f "${HR_POLICY:-$pol}"
    return $rc
  fi
  S dnf -y install "$@" >>"$LOG" 2>&1
}

# After installing openssh-server ourselves on Debian/Ubuntu: make sure the stock SSH server (port 22) is OFF.
# (If the computer already had openssh-server, we never touch its services.)
disable_stock_sshd() {
  [ "$TYPE" = debian ] || return 0
  S systemctl disable --now ssh.socket ssh.service >>"$LOG" 2>&1
  return 0
}

# Stops (returns 1, with a clear message) when this computer is not one this installer is for.
check_platform() {
  [ "$(uname -s)" = Linux ] || { fail "This installer is for Linux only."; return 1; }
  if [ "$(id -u)" = 0 ] && [ -z "${HR_ALLOW_ROOT:-}" ]; then
    fail "Run this as your normal user, not as root. It asks for your password when it needs it."; return 1
  fi
  local PRETTY_NAME="" ID="" ID_LIKE=""
  [ -r "${HR_OS_RELEASE:-/etc/os-release}" ] && . "${HR_OS_RELEASE:-/etc/os-release}"
  FAMILY="$(detect_family)"
  if [ -z "$FAMILY" ]; then
    fail "This installer is for the Fedora family (Fedora, RHEL, Rocky, AlmaLinux, CentOS Stream) and the Debian family (Debian, Ubuntu, Linux Mint, Pop!_OS...). This is: ${PRETTY_NAME:-unknown}. Ask $OWNER for the right one."; return 1
  fi
  if [ "$FAMILY" != "$TYPE" ]; then
    fail "This installer is for the $TYPE family, but this computer (${PRETTY_NAME:-?}) is in the $FAMILY family. Ask $OWNER for the $FAMILY installer."; return 1
  fi
  say "Detected: ${PRETTY_NAME:-$FAMILY family}"
  case "$(uname -m)" in x86_64|aarch64) :;; *) fail "Unsupported processor: $(uname -m)"; return 1;; esac
  if [ -z "${HR_NO_SYSTEMD:-}" ] && [ ! -d /run/systemd/system ]; then fail "This computer does not use systemd; it is not supported."; return 1; fi
  return 0
}

# ------------------------------------------------------------- screenshots
# Prints the PNG as base64 on success. Used by the installer (self-test) and by `hermes-remote screenshot`.
screenshot_snippet() {
cat <<'EOF'
d=$(mktemp -d) || exit 1; f="$d/s.png"; used=""
try() { [ -z "$used" ] && command -v "$1" >/dev/null 2>&1 || return 0; shift; "$@" >/dev/null 2>&1; if [ -s "$f" ] && [ "$(head -c4 "$f" | tail -c3)" = PNG ]; then used=1; fi; }
# Wayland (GNOME and others): the desktop screenshot portal. GNOME Shell blocks the other tools there.
# Waits up to 60 s so a person can click Allow on the first run; the answer is remembered afterwards.
portal() {
  [ "${XDG_SESSION_TYPE:-}" = wayland ] && command -v gdbus >/dev/null 2>&1 || return 0
  local mk="$d/mark" dirs new="" i p
  dirs="$(xdg-user-dir PICTURES 2>/dev/null) $HOME/Pictures $HOME/Pictures/Screenshots"
  : >"$mk"; sleep 1
  gdbus call --session --timeout 5 --dest org.freedesktop.portal.Desktop --object-path /org/freedesktop/portal/desktop --method org.freedesktop.portal.Screenshot.Screenshot "" "{'interactive': <false>}" >/dev/null 2>&1 || return 0
  [ -n "${HR_PORTAL_NOTE:-}" ] && echo "  If a pop-up asks to allow a screenshot, choose Allow now." >&2
  for i in $(seq 1 60); do
    for p in $dirs; do [ -d "$p" ] && new="$(find "$p" -maxdepth 1 -name '*.png' -newer "$mk" 2>/dev/null | head -1)"; [ -n "$new" ] && break; done
    [ -n "$new" ] && break
    sleep 1
  done
  [ -n "$new" ] || return 0
  sleep 1; cp -f "$new" "$f" 2>/dev/null; rm -f "$new"
  if [ -s "$f" ] && [ "$(head -c4 "$f" | tail -c3)" = PNG ]; then used=1; fi
}
portal
try grim grim "$f"
try gnome-screenshot gnome-screenshot -f "$f"
try spectacle spectacle -b -n -f -o "$f"
try scrot scrot -o "$f"
try import import -window root "$f"
if [ -n "$used" ]; then base64 -w0 "$f"; rc=0; else echo "no working screenshot tool in this session (session=${XDG_SESSION_TYPE:-?} desktop=${XDG_CURRENT_DESKTOP:-?})"; rc=1; fi
rm -rf "$d"; exit $rc
EOF
}

screenshot_tool_for_desktop() { # prints the package to install
  local de="${XDG_CURRENT_DESKTOP:-}" st="${XDG_SESSION_TYPE:-}"
  case "$de" in
    *GNOME*|*Unity*|*Budgie*|*Cinnamon*|*COSMIC*|*Pantheon*|*MATE*|*X-Cinnamon*) echo gnome-screenshot;;
    *KDE*|*Plasma*) echo spectacle;;
    *sway*|*Hyprland*|*river*|*wlroots*) echo grim;;
    *) if [ "$st" = wayland ]; then echo grim; else echo scrot; fi;;
  esac
}

# ------------------------------------------------------------- diagnostics
send_diag() {
  local d
  d="$(printf 'time=%s\nos=%s arch=%s\nselftest=%s\nsocket: %s\ntunnel: %s\ntunnel.log:\n%s\nsession=%s desktop=%s\nselinux=%s apparmor=%s\nstock_ssh_port22=%s\n' \
    "$(date '+%F %T')" "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}")" "$(uname -m)" "${SELFTEST:-n/a}" \
    "$(systemctl is-active agenthub-remote-sshd.socket 2>&1)" "$(systemctl is-active agenthub-remote-tunnel.service 2>&1)" \
    "$(tail -8 "$BASE/tunnel.log" 2>/dev/null)" "${XDG_SESSION_TYPE:-?}" "${XDG_CURRENT_DESKTOP:-?}" "$(getenforce 2>/dev/null || echo n/a)" "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null || echo n/a)" "$( (exec 3<>/dev/tcp/127.0.0.1/22) 2>/dev/null && echo listening || echo off)")"
  HR_DIAG_TEXT="$d" enroll >/dev/null 2>&1
}

[ "${HR_SOURCE_ONLY:-0}" = 1 ] && return 0 2>/dev/null

# ---------------------------------------------------------------------- main
mkdir -p "$(dirname "$LOG")" 2>/dev/null
[ -t 1 ] && clear
b "AgentHub Remote Support — setup for \"$NODE\""
say
say "This allows AgentHub to securely connect to this computer for diagnostics."
say "It will:"
say "  1. keep a private, encrypted connection open to $OWNER's server"
say "  2. add a private remote-access service (nothing listens on your network)"
say "  3. let $OWNER use this computer as you: open and change files, run programs, see the screen,"
say "     and make administrator-level changes"
say "This takes about 3 minutes."
say
b "What you are agreeing to"
say "  • It stays on, even after restarts, until it is removed."
say "  • To remove it later, open a terminal and run:  sudo $BASE/uninstall.sh"
say
if ! yesno "Do you want to continue?"; then say "Cancelled. Nothing was changed."; exit 0; fi

if [ "${HR_TEST:-0}" != 1 ]; then
  check_platform || exit 1
fi
pause

b "Step 1/7 — Administrator password"
if [ "${HR_TEST:-0}" != 1 ]; then
  say "Terminal will ask for your login password (you won't see it as you type)."
  if ! have_cmd sudo; then
    fail "This computer has no 'sudo' command yet. Open a terminal and run:  su -  then:  apt-get install sudo && usermod -aG sudo $DESK_USER  (Debian family)  or  dnf install sudo && usermod -aG wheel $DESK_USER  (Fedora family). Then log out, log in, and run this again."; exit 1
  fi
  S -v || { fail "Your account ($DESK_USER) is not allowed to make administrator changes. Ask the owner of this computer to add you to the 'sudo' group (Debian family) or the 'wheel' group (Fedora family), then run this again."; exit 1; }
  ( while true; do S -n true 2>/dev/null; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) &
  KEEP=$!; trap 'kill $KEEP 2>/dev/null' EXIT
fi
ok "administrator access granted"

b "Step 2/7 — Checking the internet connection to $OWNER's server"
if (exec 3<>"/dev/tcp/$RELAY_HOST/$RELAY_PORT") 2>/dev/null; then ok "server reachable"; else
  [ "${HR_TEST:-0}" = 1 ] || { fail "cannot reach $RELAY_HOST:$RELAY_PORT. Check this computer's network, then run this again."; exit 1; }
fi

b "Step 3/7 — Software"
if [ "${HR_TEST:-0}" != 1 ]; then
  need=""; SSHD_NEW=""
  have_cmd ssh || need="$need $(pkg_ssh_client)"
  if ! have_sshd; then need="$need openssh-server"; SSHD_NEW=1; fi
  have_cmd sudo || need="$need sudo"
  have_cmd flock || need="$need util-linux"
  if [ -n "$need" ]; then
    say "Installing:$need"
    install_packages $need || { fail "could not install$need (see $LOG)"; exit 1; }
  fi
  [ -n "$SSHD_NEW" ] && disable_stock_sshd
  ok "OpenSSH is installed (the normal SSH server on port 22 is NOT turned on by this installer)"
  tool="$(screenshot_tool_for_desktop)"
  if ! have_cmd "$tool"; then
    if yesno "  Install '$tool' so $OWNER can take screenshots?"; then
      install_packages "$(pkg_for_tool "$tool")" && ok "$tool installed" || warn "could not install $tool; screenshots may not work"
    else warn "skipped: screenshots may not work"; fi
  fi
fi

b "Step 4/7 — Keys and registration"
S mkdir -p "$BASE" "$RUNDIR"
if [ "${HR_TEST:-0}" != 1 ]; then
  id "$SVC_USER" >/dev/null 2>&1 || S useradd --system --home-dir /var/empty --shell /usr/sbin/nologin --user-group "$SVC_USER" >>"$LOG" 2>&1
fi
T="$(mktemp -d)"
if [ ! -f "$BASE/tunnel_ed25519" ]; then
  ssh-keygen -q -t ed25519 -N '' -C "agenthub-remote-$NODE" -f "$T/k" >>"$LOG" 2>&1 || { fail "could not make a key"; exit 1; }
  S install -m 0600 "$T/k" "$BASE/tunnel_ed25519"; S install -m 0644 "$T/k.pub" "$BASE/tunnel_ed25519.pub"
  own "$SVC_USER:$SVC_USER" "$BASE/tunnel_ed25519"
fi
if [ ! -f "$HOSTKEY" ]; then
  ssh-keygen -q -t ed25519 -N '' -C "agenthub-remote-host-$NODE" -f "$T/h" >>"$LOG" 2>&1 || { fail "could not make a key"; exit 1; }
  S install -m 0600 "$T/h" "$HOSTKEY"; S install -m 0644 "$T/h.pub" "$HOSTKEY.pub"
fi
printf '[%s]:%s %s\n' "$RELAY_HOST" "$RELAY_PORT" "$RELAY_HOSTKEY" >"$T/kh"
S install -m 0644 "$T/kh" "$BASE/relay_known_hosts"
rm -rf "$T"
enroll || exit 1
CODE="$(pair_code)"

b "Step 5/7 — Private remote-access service"
T="$(mktemp -d)"
render_sshd_config >"$T/sshd_config"
printf '%s\n' "$HERMES_PUB" >"$T/authorized_keys"
printf 'hermes namespaces="hermes-remote-job" %s\n' "$(printf '%s' "$HERMES_PUB" | awk '{print $1" "$2}')" >"$T/allowed_signers"
S install -m 0644 "$T/sshd_config" "$BASE/sshd_config"
S install -m 0644 "$T/authorized_keys" "$BASE/authorized_keys"
S install -m 0644 "$T/allowed_signers" "$BASE/allowed_signers"
if [ "${HR_TEST:-0}" != 1 ]; then
  S /usr/sbin/sshd -t -f "$BASE/sshd_config" >>"$LOG" 2>&1 || { fail "the SSH server settings were rejected (see $LOG)"; exit 1; }
  render_socket_unit >"$T/s.socket"; render_sshd_service >"$T/s.service"; render_tunnel_unit "$SSH_PORT" >"$T/t.service"
  S install -m 0644 "$T/s.socket" "$UNITDIR/agenthub-remote-sshd.socket"
  S install -m 0644 "$T/s.service" "$UNITDIR/agenthub-remote-sshd@.service"
  S install -m 0644 "$T/t.service" "$UNITDIR/agenthub-remote-tunnel.service"
  touch "$BASE/tunnel.log" 2>/dev/null || S touch "$BASE/tunnel.log"; own "$SVC_USER:$SVC_USER" "$BASE/tunnel.log"
  sysctl_ daemon-reload
  sysctl_ enable --now agenthub-remote-sshd.socket >>"$LOG" 2>&1 && ok "private SSH socket is on (starts with the computer)" || warn "the SSH socket did not start (see $LOG)"
  sysctl_ enable --now agenthub-remote-tunnel.service >>"$LOG" 2>&1 && ok "tunnel service is on (starts with the computer)" || warn "the tunnel did not start (see $LOG)"
  # SELinux: units run in default domains; report the mode to the owner through the diagnostics
  command -v getenforce >/dev/null 2>&1 && say "  SELinux: $(getenforce)"
fi
case "$SUDO_MODE" in
  yes) DO_SUDO=1;;
  no) DO_SUDO=0;;
  ask) yesno "  Let $OWNER run administrator commands without asking you each time?" && DO_SUDO=1 || DO_SUDO=0;;
  *) DO_SUDO=1;;
esac
if [ "$DO_SUDO" = 1 ]; then
  render_sudoers >"$T/sudoers"
  if [ "${HR_TEST:-0}" = 1 ] || visudo -cf "$T/sudoers" >>"$LOG" 2>&1; then
    S mkdir -p "$(dirname "$SUDOERS_FILE")"; S install -m 0440 "$T/sudoers" "$SUDOERS_FILE"; ok "administrator commands allowed for remote support"
  else fail "the sudo settings were rejected; skipped"; fi
else say "  Administrator commands for remote support: off"; fi
rm -rf "$T"

b "Step 6/7 — Helper for your desktop"
mkdir -p "$IPC/jobs" "$(dirname "$AUTOSTART")"; chmod 700 "$DESK_HOME/.local/share/agenthub-remote" "$IPC" "$IPC/jobs" 2>/dev/null
printf '%s' "$HELPER_B64" | base64 --decode >"$HELPER"; chmod 700 "$HELPER"
render_autostart >"$AUTOSTART"
if [ "${HR_TEST:-0}" != 1 ]; then
  if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    ( nohup /bin/bash "$HELPER" >>"$LOG" 2>&1 & ) ; sleep 2
    [ -s "$IPC/status.txt" ] && ok "helper is running (it also starts every time you log in)" || warn "the helper did not start (see $LOG)"
    say "  Testing a screenshot (a pop-up may ask you to allow it: choose Allow)..."
    shot="$(screenshot_snippet | HR_PORTAL_NOTE=1 bash 2>&1)"
    if [ "$(printf '%s' "$shot" | head -c 12)" = "iVBORw0KGgoA" ]; then ok "screenshots work"; SHOT_RESULT=ok
    else warn "screenshots do not work yet: ${shot:0:140}"; SHOT_RESULT="failed: ${shot:0:140}"; fi
  else
    warn "no desktop session found (this looks like a text-only session). The helper will start when you log in to the desktop."
  fi
  if [ "${HR_NO_POWER:-}" != 1 ] && yesno "  Keep this computer awake while plugged in (ignore the laptop lid on power)?"; then
    S mkdir -p "$(dirname "$LOGIND_FILE")"; render_logind | S tee "$LOGIND_FILE" >/dev/null
    S systemctl kill -s HUP systemd-logind >>"$LOG" 2>&1
    if command -v gsettings >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
      gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type 'nothing' >>"$LOG" 2>&1
    fi
    ok "stays awake while plugged in"
  fi
fi

b "Step 7/7 — Checking the connection"
SELFTEST="$(tunnel_selftest)"
case "$SELFTEST" in
  *"Host key verification failed"*) fail "this computer does not trust the server's identity; $OWNER will be told automatically.";;
  *"Permission denied"*) ok "server reachable and trusted (waiting for $OWNER to approve this computer)";;
  *"timed out"*|*refused*|*resolve*|*"No route"*) warn "cannot reach the server right now: $SELFTEST";;
  *) ok "secure connection works";;
esac
T="$(mktemp -d)"; render_uninstall >"$T/u"; S install -m 0755 "$T/u" "$BASE/uninstall.sh"; rm -rf "$T"
[ "${HR_TEST:-0}" = 1 ] || send_diag

echo
b "ALL DONE ✔"
say
say "Please read this code to $OWNER so they can finish connecting this computer:"
printf '\n        \033[1;7m  %s  \033[0m\n\n' "$CODE"
say "(Keep this window open until you've told them. You can then close it.)"
pause
