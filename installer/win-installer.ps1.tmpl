# AgentHub Remote installer for Windows (@@TYPE@@), generated by hermes-remote.
# Valid until @@EXPIRES@@. It can only register this computer as PENDING:
# nothing works until the owner approves the code this computer shows. Safe to read.
#
# What it does, in order (it asks you before it changes anything):
#   1. downloads Microsoft's OpenSSH build (fixed version, SHA-256 checked) into C:\ProgramData\AgentHubRemote
#   2. makes keys, registers this computer with the owner's relay, and shows an approval code
#   3. installs a private SSH service (only reachable from this computer), the connection task and a helper
#   4. sets "do not sleep while plugged in"
# Remove everything later with: C:\ProgramData\AgentHubRemote\uninstall.ps1 (as administrator)
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
$Type = @@TYPE@@
$Owner = @@OWNER@@
$RelayHost = @@RELAY_HOST@@
$RelayPort = @@RELAY_PORT@@
$RelayUser = @@RELAY_USER@@
$RelayHostKey = @@RELAY_HOSTKEY@@
$OperatorPub = @@HERMES_PUB@@
$EnrollKeyB64 = @@ENROLL_KEY_B64@@
$HelperB64 = @@HELPER_B64@@
$Generated = @@DATE@@
$JoinMode = @@JOIN_MODE@@

# pinned Microsoft OpenSSH build (https://github.com/PowerShell/Win32-OpenSSH/releases/tag/10.0.0.0p2-Preview)
$SshZips = @{
    win64 = @{ Url = 'https://github.com/PowerShell/Win32-OpenSSH/releases/download/10.0.0.0p2-Preview/OpenSSH-Win64.zip'; Sha256 = '23f50f3458c4c5d0b12217c6a5ddfde0137210a30fa870e98b29827f7b43aba5'; Dir = 'OpenSSH-Win64' }
    win32 = @{ Url = 'https://github.com/PowerShell/Win32-OpenSSH/releases/download/10.0.0.0p2-Preview/OpenSSH-Win32.zip'; Sha256 = 'c61d7fea20ddfe0fc50eb56210a66464557721120f7794ff9cc883b5ba526abd'; Dir = 'OpenSSH-Win32' }
}

# Overridable for tests (HR_TEST=1 skips every Windows-only, system-changing step).
$Base = if ($env:HR_BASE) { $env:HR_BASE } else { Join-Path $env:ProgramData 'AgentHubRemote' }
$SshdPort = 22022
$ServiceName = 'AgentHubSshd'
$TunnelTask = 'AgentHubRemoteTunnel'
$HelperTask = 'AgentHubRemoteHelper'
$Log = Join-Path $Base 'install.log'
$SshDir = Join-Path $Base 'openssh'
$NullDev = if ([System.IO.Path]::DirectorySeparatorChar -eq '/') { '/dev/null' } else { 'NUL' }   # '/' only on the Linux test host

function Write-Log([string]$m) { try { Add-Content -LiteralPath $Log -Value ((Get-Date).ToString('s') + ' ' + $m) } catch { } }
function Say([string]$m) { Write-Host $m }
function Bold([string]$m) { Write-Host ''; Write-Host $m -ForegroundColor White }
function Ok([string]$m) { Write-Host ('  [ok] ' + $m) -ForegroundColor Green; Write-Log ('ok ' + $m) }
function Warn([string]$m) { Write-Host ('  [!]  ' + $m) -ForegroundColor Yellow; Write-Log ('warn ' + $m) }
function Fail([string]$m) { Write-Host ('  [x]  ' + $m) -ForegroundColor Red; Write-Log ('fail ' + $m) }
function Ask-YesNo([string]$q) {
    if ($env:HR_TEST -eq '1') { return $true }
    $a = Read-Host ($q + ' [Y/n]')
    return -not ($a -match '^(n|no)$')
}
function Pause-Here { if ($env:HR_TEST -ne '1') { [void](Read-Host '  Press Enter to continue') } }

function Quote-Arg([string]$a) {
    if ($a -eq '') { return '""' }
    if ($a -notmatch '[\s"]') { return $a }
    return '"' + $a.Replace('"', '\"') + '"'
}

# Runs a program with exact arguments (empty arguments survive) and optional stdin bytes.
function Invoke-Native([string]$Exe, [string[]]$Arguments, [byte[]]$StdIn, [int]$TimeoutSec = 60) {
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $Exe
    $psi.Arguments = (($Arguments | ForEach-Object { Quote-Arg $_ }) -join ' ')
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true
    $psi.RedirectStandardInput = $true
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $p = New-Object System.Diagnostics.Process
    $p.StartInfo = $psi
    [void]$p.Start()
    $so = New-Object System.IO.MemoryStream
    $se = New-Object System.IO.MemoryStream
    $t1 = $p.StandardOutput.BaseStream.CopyToAsync($so)
    $t2 = $p.StandardError.BaseStream.CopyToAsync($se)
    try {
        if ($StdIn -and $StdIn.Length -gt 0) { $p.StandardInput.BaseStream.Write($StdIn, 0, $StdIn.Length) }
        $p.StandardInput.Close()
    } catch { }
    $code = 124
    if ($p.WaitForExit($TimeoutSec * 1000)) {
        $code = $p.ExitCode
        [void]$t1.Wait(5000); [void]$t2.Wait(5000)
    } else {
        try { $p.Kill() } catch { }
    }
    $enc = [System.Text.Encoding]::UTF8
    return @{ Code = $code; Out = $enc.GetString($so.ToArray()); Err = $enc.GetString($se.ToArray()) }
}

function Get-Sha256Hex([byte[]]$Bytes) {
    $h = [System.Security.Cryptography.SHA256]::Create()
    try { return (($h.ComputeHash($Bytes) | ForEach-Object { $_.ToString('x2') }) -join '') } finally { $h.Dispose() }
}

# the name shown to the owner: the computer name, letters/digits/space/dot/dash only
function Get-NodeName {
    $n = if ($env:HR_FAKE_HOSTNAME) { $env:HR_FAKE_HOSTNAME } else { $env:COMPUTERNAME }
    $n = ($n -replace '[^A-Za-z0-9 ._-]', '')
    if (-not $n) { $n = 'windows-pc' }
    return $n
}

# the person who is signed in at the screen (the installer may run under another administrator account)
function Get-DesktopUser {
    if ($env:HR_FAKE_USER) { return $env:HR_FAKE_USER }
    try {
        $u = (Get-CimInstance -ClassName Win32_ComputerSystem -ErrorAction Stop).UserName
        if ($u) { return ($u -split '\\')[-1] }
    } catch { }
    return $env:USERNAME
}

function Get-ArchLabel { if ($Type -eq 'win32') { return 'x86' } else { return 'x64' } }

function Pub-Blob([string]$line) { return ($line.Trim() -split '\s+')[1] }

# 40-bit code both sides derive from the tunnel key and this computer's SSH host key
function Get-PairCode([string]$TunnelPub, [string]$HostPub) {
    $msg = (Pub-Blob $TunnelPub) + '|' + (Pub-Blob $HostPub)
    $h = (Get-Sha256Hex ([System.Text.Encoding]::UTF8.GetBytes($msg))).Substring(0, 10).ToUpper()
    return ($h.Substring(0, 5) + '-' + $h.Substring(5, 5))
}

function Set-PrivateAcl([string]$Path, [bool]$IsDir) {
    # only SYSTEM and Administrators (S-1-5-18, S-1-5-32-544); other accounts get nothing
    $grant = if ($IsDir) { ':(OI)(CI)F' } else { ':F' }
    $r = Invoke-Native 'icacls.exe' @($Path, '/inheritance:r', '/grant:r', ('*S-1-5-18' + $grant), '/grant:r', ('*S-1-5-32-544' + $grant)) $null 30
    if ($r.Code -ne 0) { throw ('could not restrict access to ' + $Path + ': ' + $r.Err + $r.Out) }
}

function New-Keypair([string]$Path, [string]$Comment) {
    $ssh = Join-Path $SshDir 'ssh-keygen.exe'
    if (-not (Test-Path -LiteralPath $ssh)) { $ssh = 'ssh-keygen' }
    $r = Invoke-Native $ssh @('-q', '-t', 'ed25519', '-N', '', '-C', $Comment, '-f', $Path) $null 30
    if ($r.Code -ne 0 -or -not (Test-Path -LiteralPath $Path)) { throw ('ssh-keygen failed: ' + $r.Err) }
}

function Get-SshExe { $p = Join-Path $SshDir 'ssh.exe'; if (Test-Path -LiteralPath $p) { return $p } else { return 'ssh' } }

function Write-RelayKnownHosts {
    $f = Join-Path $Base 'relay_known_hosts'
    [System.IO.File]::WriteAllText($f, ('[{0}]:{1} {2}' -f $RelayHost, $RelayPort, $RelayHostKey) + "`n", [System.Text.Encoding]::ASCII)
    return $f
}

function Get-OsLabel {
    try { $o = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop; return ($o.Caption + ' ' + $o.Version) } catch { return 'Windows' }
}

# registers this computer with the owner's relay; returns @{ SshPort; Name } or throws
function Register-Node([string]$DiagText) {
    $tunnelPub = (Get-Content -LiteralPath (Join-Path $Base 'tunnel_ed25519.pub') -Raw).Trim()
    $hostPub = (Get-Content -LiteralPath (Join-Path $Base 'ssh_host_ed25519_key.pub') -Raw).Trim()
    $payload = @{
        tunnel_pub = (($tunnelPub -split '\s+')[0..1] -join ' ')
        mac_hostkey = (($hostPub -split '\s+')[0..1] -join ' ')
        mac_user = (Get-DesktopUser)
        hostname = (Get-NodeName)
        arch = (Get-ArchLabel)
        platform = 'windows'
        type = $Type
        os = (Get-OsLabel)
        diag_b64 = [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes($DiagText))
    }
    $json = $payload | ConvertTo-Json -Compress
    $tmp = Join-Path $Base 'tmp'
    New-Item -ItemType Directory -Force -Path $tmp | Out-Null
    $keyFile = Join-Path $tmp 'enroll'
    $khFile = Join-Path $tmp 'enroll_known_hosts'
    [System.IO.File]::WriteAllBytes($keyFile, [Convert]::FromBase64String($EnrollKeyB64))
    [System.IO.File]::WriteAllText($khFile, ('[{0}]:{1} {2}' -f $RelayHost, $RelayPort, $RelayHostKey) + "`n", [System.Text.Encoding]::ASCII)
    if ($env:HR_TEST -ne '1') { Set-PrivateAcl $keyFile $false } elseif ($NullDev -ne 'NUL') { & chmod 600 $keyFile }
    try {
        $r = Invoke-Native (Get-SshExe) @(
            '-T', '-i', $keyFile, '-p', "$RelayPort", '-F', $NullDev, '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes',
            '-o', 'StrictHostKeyChecking=yes', '-o', 'HostKeyAlgorithms=ssh-ed25519', '-o', ('UserKnownHostsFile=' + ($khFile -replace '\\', '/')),
            '-o', ('GlobalKnownHostsFile=' + $NullDev), '-o', 'ConnectTimeout=15', ($RelayUser + '@' + $RelayHost)
        ) ([System.Text.Encoding]::UTF8.GetBytes($json)) 40
    } finally {
        Remove-Item -LiteralPath $keyFile, $khFile -Force -ErrorAction SilentlyContinue
    }
    $resp = ($r.Out.Trim())
    Write-Log ('enroll response: ' + $resp + ' ' + $r.Err.Trim())
    if ($resp -match '^OK (\d+) (\d+) ([a-z0-9-]+)') {
        $res = @{ SshPort = [int]$Matches[1]; Name = $Matches[3] }
        [System.IO.File]::WriteAllText((Join-Path $Base 'enrolled'), ("{0} {1}`n" -f $res.SshPort, $res.Name))
        return $res
    }
    if ($r.Err -match 'Host key verification failed') { throw "this computer does not trust the server's identity; $Owner will be told automatically." }
    throw ('registration was refused (' + $(if ($resp) { $resp } else { 'no answer' }) + '). The installer may have expired; ask for a new one.')
}

function Test-Tunnel {
    $r = Invoke-Native (Get-SshExe) @(
        '-F', $NullDev, '-i', (Join-Path $Base 'tunnel_ed25519'), '-p', "$RelayPort", '-o', 'IdentitiesOnly=yes', '-o', 'BatchMode=yes',
        '-o', 'StrictHostKeyChecking=yes', '-o', 'HostKeyAlgorithms=ssh-ed25519',
        '-o', ('UserKnownHostsFile=' + ((Join-Path $Base 'relay_known_hosts') -replace '\\', '/')), '-o', ('GlobalKnownHostsFile=' + $NullDev),
        '-o', 'ConnectTimeout=10', ($RelayUser + '@' + $RelayHost), 'true'
    ) $null 25
    return (($r.Out + ' ' + $r.Err).Trim() -replace '\s+', ' ')
}

function Get-TunnelScript([int]$SshPort) {
@"
# AgentHub Remote: keeps the outbound connection to the owner's relay open (runs as SYSTEM at startup).
`$ErrorActionPreference = 'Continue'
`$base = '$($Base -replace "'", "''")'
`$ssh = Join-Path `$base 'openssh\ssh.exe'
`$log = Join-Path `$base 'tunnel.log'
while (`$true) {
    if ((Test-Path -LiteralPath `$log) -and ((Get-Item -LiteralPath `$log).Length -gt 1MB)) { Remove-Item -LiteralPath `$log -Force -ErrorAction SilentlyContinue }
    & `$ssh -N -T -F NUL -i (Join-Path `$base 'tunnel_ed25519') -p $RelayPort ``
        -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o HostKeyAlgorithms=ssh-ed25519 ``
        -o ('UserKnownHostsFile=' + ((Join-Path `$base 'relay_known_hosts') -replace '\\','/')) -o GlobalKnownHostsFile=NUL ``
        -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=15 ``
        -R 127.0.0.1:${SshPort}:127.0.0.1:$SshdPort ``
        '$RelayUser@$RelayHost' 2>> `$log
    Start-Sleep -Seconds 15
}
"@
}

function Get-SshdConfig {
    $b = $Base -replace '\\', '/'
@"
# AgentHub Remote private SSH server: reachable only from this computer (the tunnel forwards to it).
Port $SshdPort
ListenAddress 127.0.0.1
HostKey $b/ssh_host_ed25519_key
PidFile $b/sshd.pid
AuthorizedKeysFile $b/authorized_keys
StrictModes no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AllowTcpForwarding no
GatewayPorts no
X11Forwarding no
MaxAuthTries 3
LoginGraceTime 20
ClientAliveInterval 30
ClientAliveCountMax 4
LogLevel INFO
"@
}

function Get-UninstallScript {
@"
# Removes AgentHub Remote Support. Run in an administrator PowerShell:  powershell -ExecutionPolicy Bypass -File "$Base\uninstall.ps1"
`$ErrorActionPreference = 'Continue'
Stop-ScheduledTask -TaskName '$TunnelTask' -ErrorAction SilentlyContinue
Stop-ScheduledTask -TaskName '$HelperTask' -ErrorAction SilentlyContinue
Unregister-ScheduledTask -TaskName '$TunnelTask' -Confirm:`$false -ErrorAction SilentlyContinue
Unregister-ScheduledTask -TaskName '$HelperTask' -Confirm:`$false -ErrorAction SilentlyContinue
Stop-Service -Name '$ServiceName' -Force -ErrorAction SilentlyContinue
sc.exe delete '$ServiceName' | Out-Null
Get-CimInstance Win32_Process | Where-Object { `$_.ExecutablePath -like '$($Base -replace "'", "''")\*' -or (`$_.CommandLine -like '*$($Base -replace "'", "''")\helper.ps1*') } | ForEach-Object { Stop-Process -Id `$_.ProcessId -Force -ErrorAction SilentlyContinue }
Start-Sleep -Seconds 2
Remove-Item -LiteralPath '$($Base -replace "'", "''")' -Recurse -Force -ErrorAction SilentlyContinue
Write-Host 'AgentHub Remote Support removed. Power settings were left as they are.'
"@
}

function Get-DiagText([string]$SelfTest) {
    $svc = ''; $tun = ''; $listen = 'unknown'
    try { $svc = (Get-Service -Name $ServiceName -ErrorAction Stop).Status } catch { $svc = 'missing' }
    try { $tun = (Get-ScheduledTask -TaskName $TunnelTask -ErrorAction Stop).State } catch { $tun = 'missing' }
    try { $listen = [bool](Get-NetTCPConnection -LocalPort $SshdPort -State Listen -ErrorAction Stop) } catch { }
    $tail = ''
    try { $tail = (Get-Content -LiteralPath (Join-Path $Base 'tunnel.log') -Tail 8 -ErrorAction Stop) -join "`n" } catch { }
    return ("time=" + (Get-Date).ToString('s') + "`nos=" + (Get-OsLabel) + " type=" + $Type + "`nselftest=" + $SelfTest + "`nsshd_service=" + $svc + " sshd_listening=" + $listen + "`ntunnel_task=" + $tun + "`ntunnel.log:`n" + $tail + "`n")
}

# ------------------------------------------------------------------------------------------ main
if ($env:HR_SOURCE_ONLY -eq '1') { return }

if ($env:HR_TEST -ne '1') {
    $isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    if (-not $isAdmin) {
        Write-Host ''
        Say '  AgentHub Remote Support needs administrator rights. Windows will ask for permission: choose Yes.'
        $self = $PSCommandPath
        if (-not $self) { Fail 'cannot restart as administrator from here; right-click the file and choose "Run as administrator".'; return }
        try { Start-Process -FilePath 'powershell.exe' -Verb RunAs -Wait -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ('"' + $self + '"')) }
        catch { Fail 'administrator permission was not given; nothing was changed.'; Pause-Here }
        return
    }
    $build = [int](Get-CimInstance Win32_OperatingSystem).BuildNumber
    if ($build -lt 17763) { Fail 'This needs Windows 10 version 1809 or newer.'; Pause-Here; return }
    $os64 = [Environment]::Is64BitOperatingSystem
    if ($Type -eq 'win64' -and -not $os64) { Fail 'This Windows is 32-bit. Use the x32 installer.'; Pause-Here; return }
    if ($Type -eq 'win32' -and $os64) { Warn 'This Windows is 64-bit. The 32-bit version also works, but the x64 installer is better.' }
}

$Name = Get-NodeName
Write-Host ''
Write-Host '  AgentHub Remote Support' -ForegroundColor White
Write-Host ('  Set up by: ' + $Owner)
Write-Host ''
Say "  This lets $Owner connect to THIS computer from anywhere on the internet to fix and test things."
Say '  If you continue:'
Say "    - $Owner will be able to run programs, read and change files, and see the screen, as the signed-in user"
Say '      (who is an administrator on most home computers).'
Say '    - It starts by itself when Windows starts, and stays on until it is removed.'
Say '    - Nothing works until you read the approval code at the end to the person who sent you.'
Say '    - To remove it later: run  C:\ProgramData\AgentHubRemote\uninstall.ps1  as administrator.'
Say ''
if (-not (Ask-YesNo "  Do you want to continue?")) { Say '  Nothing was changed.'; return }

try {
    Bold 'Step 1/6 - Preparing'
    New-Item -ItemType Directory -Force -Path $Base | Out-Null
    if ($env:HR_TEST -ne '1') {
        Get-Service -Name $ServiceName -ErrorAction SilentlyContinue | Stop-Service -Force -ErrorAction SilentlyContinue
        Stop-ScheduledTask -TaskName $TunnelTask -ErrorAction SilentlyContinue
        Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object { $_.ExecutablePath -and $_.ExecutablePath -like ($Base + '\openssh\*') } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }
        Set-PrivateAcl $Base $true
        $users = Invoke-Native 'icacls.exe' @($Base, '/grant', '*S-1-5-32-545:(OI)(CI)RX') $null 30   # helper (a normal user process) must read its script
    }
    Ok ('working folder ' + $Base)

    Bold 'Step 2/6 - Downloading the connection tools (Microsoft OpenSSH)'
    $z = $SshZips[$Type]
    if ($env:HR_TEST -ne '1' -or $env:HR_FAKE_ZIP) {
        $zipPath = Join-Path $Base 'openssh.zip'
        if ($env:HR_FAKE_ZIP) { Copy-Item -LiteralPath $env:HR_FAKE_ZIP -Destination $zipPath -Force }
        else {
            [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
            Invoke-WebRequest -UseBasicParsing -Uri $z.Url -OutFile $zipPath
        }
        $got = (Get-FileHash -LiteralPath $zipPath -Algorithm SHA256).Hash.ToLower()
        $want = if ($env:HR_FAKE_ZIP) { $env:HR_FAKE_ZIP_SHA256 } else { $z.Sha256 }
        if ($got -ne $want) { Remove-Item -LiteralPath $zipPath -Force; throw 'the download does not match its fixed checksum; stopping.' }
        if (Test-Path -LiteralPath $SshDir) { Remove-Item -LiteralPath $SshDir -Recurse -Force }
        $ex = Join-Path $Base 'unzip'
        if (Test-Path -LiteralPath $ex) { Remove-Item -LiteralPath $ex -Recurse -Force }
        Expand-Archive -LiteralPath $zipPath -DestinationPath $ex -Force
        Move-Item -LiteralPath (Join-Path $ex $z.Dir) -Destination $SshDir
        Remove-Item -LiteralPath $ex, $zipPath -Recurse -Force
        Ok 'connection tools installed and checksum verified'
    }

    Bold 'Step 3/6 - Keys and registration'
    $tk = Join-Path $Base 'tunnel_ed25519'
    if (-not (Test-Path -LiteralPath $tk)) { New-Keypair $tk ('agenthub-remote-' + $Name) }
    $hk = Join-Path $Base 'ssh_host_ed25519_key'
    if (-not (Test-Path -LiteralPath $hk)) { New-Keypair $hk ('agenthub-remote-host-' + $Name) }
    if ($env:HR_TEST -ne '1') { foreach ($f in @($tk, $hk)) { Set-PrivateAcl $f $false } }
    [void](Write-RelayKnownHosts)
    $reg = Register-Node ''
    Ok ("registered as '" + $reg.Name + "' with " + $Owner + "'s relay")

    if ($env:HR_TEST -ne '1') {
        Bold 'Step 4/6 - Private SSH service'
        [System.IO.File]::WriteAllText((Join-Path $Base 'sshd_config'), ((Get-SshdConfig) -replace "`r?`n", "`r`n"), [System.Text.Encoding]::ASCII)
        [System.IO.File]::WriteAllText((Join-Path $Base 'authorized_keys'), ($OperatorPub.Trim() + "`n"), [System.Text.Encoding]::ASCII)
        [System.IO.File]::WriteAllText((Join-Path $Base 'allowed_signers'), ('hermes namespaces="hermes-remote-job" ' + (($OperatorPub.Trim() -split '\s+')[0..1] -join ' ') + "`n"), [System.Text.Encoding]::ASCII)
        foreach ($f in @('sshd_config', 'authorized_keys', 'allowed_signers')) { Set-PrivateAcl (Join-Path $Base $f) $false }
        [void](Invoke-Native 'icacls.exe' @((Join-Path $Base 'allowed_signers'), '/grant', '*S-1-5-32-545:R') $null 30)   # the helper checks job signatures with it
        $sshd = Join-Path $SshDir 'sshd.exe'
        New-Item -ItemType Directory -Force -Path (Join-Path (Join-Path $env:ProgramData 'ssh') 'logs') | Out-Null   # OpenSSH for Windows writes its log here
        $bin = '"' + $sshd + '" -f "' + (Join-Path $Base 'sshd_config') + '"'
        if (Get-Service -Name $ServiceName -ErrorAction SilentlyContinue) { [void](Invoke-Native 'sc.exe' @('delete', $ServiceName) $null 30); Start-Sleep -Seconds 2 }
        New-Service -Name $ServiceName -DisplayName 'AgentHub Remote private SSH' -BinaryPathName $bin -StartupType Automatic -Description 'SSH server that only this computer can reach; used by AgentHub Remote Support.' | Out-Null
        [void](Invoke-Native 'sc.exe' @('privs', $ServiceName, 'SeAssignPrimaryTokenPrivilege/SeTcbPrivilege/SeBackupPrivilege/SeRestorePrivilege/SeImpersonatePrivilege') $null 30)
        [void](Invoke-Native 'sc.exe' @('failure', $ServiceName, 'reset=', '86400', 'actions=', 'restart/10000/restart/10000/restart/10000') $null 30)
        Start-Service -Name $ServiceName
        Start-Sleep -Seconds 3
        $listening = $false
        try { $listening = [bool](Get-NetTCPConnection -LocalPort $SshdPort -State Listen -ErrorAction Stop) } catch { }
        if ($listening) { Ok 'private SSH service is running (starts with Windows)' } else { Warn 'the private SSH service did not start; the owner will see the details.' }

        Bold 'Step 5/6 - Connection task and helper'
        [System.IO.File]::WriteAllText((Join-Path $Base 'tunnel.ps1'), ((Get-TunnelScript $reg.SshPort) -replace "`r?`n", "`r`n"), [System.Text.Encoding]::ASCII)
        [System.IO.File]::WriteAllBytes((Join-Path $Base 'helper.ps1'), [Convert]::FromBase64String($HelperB64))
        [System.IO.File]::WriteAllText((Join-Path $Base 'uninstall.ps1'), ((Get-UninstallScript) -replace "`r?`n", "`r`n"), [System.Text.Encoding]::ASCII)
        $ipc = Join-Path $Base 'ipc'; $jobs = Join-Path $ipc 'jobs'
        New-Item -ItemType Directory -Force -Path $jobs | Out-Null
        $user = Get-DesktopUser
        $sid = $null
        try { $sid = (New-Object System.Security.Principal.NTAccount($user)).Translate([System.Security.Principal.SecurityIdentifier]).Value } catch { Warn ('could not look up the account ' + $user) }
        if ($sid) { [void](Invoke-Native 'icacls.exe' @($ipc, '/grant', ('*' + $sid + ':(OI)(CI)M')) $null 30) }
        $ps = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
        $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1) -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances IgnoreNew
        $tAct = New-ScheduledTaskAction -Execute $ps -Argument ('-NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File "' + (Join-Path $Base 'tunnel.ps1') + '"')
        Register-ScheduledTask -TaskName $TunnelTask -Action $tAct -Trigger (New-ScheduledTaskTrigger -AtStartup) -Settings $settings -Principal (New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest) -Force | Out-Null
        Start-ScheduledTask -TaskName $TunnelTask
        Ok 'connection task installed (starts with Windows)'
        $hAct = New-ScheduledTaskAction -Execute $ps -Argument ('-NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File "' + (Join-Path $Base 'helper.ps1') + '"')
        $hTrig = New-ScheduledTaskTrigger -AtLogOn -User ($env:COMPUTERNAME + '\' + $user)
        Register-ScheduledTask -TaskName $HelperTask -Action $hAct -Trigger $hTrig -Settings $settings -Principal (New-ScheduledTaskPrincipal -UserId ($env:COMPUTERNAME + '\' + $user) -LogonType Interactive -RunLevel Limited) -Force | Out-Null
        Start-ScheduledTask -TaskName $HelperTask
        Ok 'helper installed (runs in your desktop session; needed for screenshots)'

        Bold 'Step 6/6 - Stay awake while plugged in'
        if (Ask-YesNo '  Keep this computer from sleeping while it is plugged in?') {
            [void](Invoke-Native 'powercfg.exe' @('/change', 'standby-timeout-ac', '0') $null 30)
            [void](Invoke-Native 'powercfg.exe' @('/change', 'hibernate-timeout-ac', '0') $null 30)
            Ok 'sleep and hibernate are off while plugged in (the screen can still turn off)'
        } else { Warn 'skipped: the computer may be unreachable when it sleeps' }
    }

    Bold 'Checking the connection'
    $self = Test-Tunnel
    if ($self -match 'Host key verification failed') { Fail ("this computer does not trust the server's identity; " + $Owner + " will be told automatically.") }
    elseif ($self -match 'Permission denied') { Ok ('server reachable and trusted (waiting for ' + $Owner + ' to approve this computer)') }
    elseif ($self -match 'timed out|refused|resolve|No route') { Warn ('cannot reach the server right now: ' + $self) }
    else { Ok 'secure connection works' }
    $dg = Get-DiagText $self
    try { [void](Register-Node $dg) } catch { Write-Log ('diag send failed: ' + $_.Exception.Message) }

    $code = Get-PairCode (Get-Content -LiteralPath (Join-Path $Base 'tunnel_ed25519.pub') -Raw) (Get-Content -LiteralPath (Join-Path $Base 'ssh_host_ed25519_key.pub') -Raw)
    Write-Host ''
    Write-Host '  ============================================' -ForegroundColor Cyan
    Write-Host ("   Read this code to " + $Owner + ":") -ForegroundColor Cyan
    Write-Host ''
    Write-Host ("        " + $code) -ForegroundColor White
    Write-Host ''
    Write-Host '  ============================================' -ForegroundColor Cyan
    Write-Host '  Nothing works until they approve this code. You can close this window after you give it to them.'
    Write-Host ''
    Pause-Here
} catch {
    Fail $_.Exception.Message
    Write-Log ('error: ' + $_.Exception.ToString())
    Say ('  The details are in ' + $Log + '. Tell ' + $Owner + ' what happened.')
    Pause-Here
}
